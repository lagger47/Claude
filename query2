Query SQL
SELECT B.COMPANY, A.EMPLID, E.NAME, A.STATE, B.TAX_LOCATION_CD, MAX((CASE WHEN  C.RESIDENT = 'Y'
THEN
C.STATE
END)), MAX((CASE WHEN  C.UI_JURISDICTION = 'Y'
THEN
C.STATE
END)), TO_CHAR(A.ASOFDATE,'YYYY-MM-DD'), B.EMPL_STATUS, D.STATE, D.LOCALITY, MAX((CASE WHEN  C.UI_JURISDICTION = 'Y'
THEN
C.STATE RESIDENT
END)), B.EMPLID, B.LOCATION, B.PAYGROUP, C.EMPLID, C.COMPANY, TO_CHAR(C.EFFDT,'YYYY-MM-DD'), C.STATE, C.RESIDENT, C.UI_JURISDICTION, E.EMPLID, E.FIRST_NAME, E.LAST_NAME
  FROM PS_PERSON_ADDR_HOM A, PS_JOB B, PS_EMPLMT_SRCH_QRY B1, PS_STATE_TAX_DATA C, PS_PERSON_NAME E, PS_TAX_DISTRIB D
  WHERE ( B.EMPLID = B1.EMPLID
    AND B.EMPL_RCD = B1.EMPL_RCD
    AND B1.OPRID = 'U304418'
    AND ( A.EMPLID = B.EMPLID
     AND B.EFFDT =
        (SELECT MAX(B_ED.EFFDT) FROM PS_JOB B_ED
        WHERE B.EMPLID = B_ED.EMPLID
          AND B.EMPL_RCD = B_ED.EMPL_RCD
          AND B_ED.EFFDT <= SYSDATE)
    AND B.EFFSEQ =
        (SELECT MAX(B_ES.EFFSEQ) FROM PS_JOB B_ES
        WHERE B.EMPLID = B_ES.EMPLID
          AND B.EMPL_RCD = B_ES.EMPL_RCD
          AND B.EFFDT = B_ES.EFFDT)
     AND B.EMPL_STATUS = 'A'
     AND B.EMPLID = C.EMPLID
     AND C.COMPANY = B.COMPANY
     AND C.EFFDT =
        (SELECT MAX(C_ED.EFFDT) FROM PS_STATE_TAX_DATA C_ED
        WHERE C.EMPLID = C_ED.EMPLID
          AND C.COMPANY = C_ED.COMPANY
          AND C_ED.EFFDT <= SYSDATE)
     AND B.EMPLID = E.EMPLID
     AND C.EMPLID = D.EMPLID
     AND C.STATE = D.STATE
     AND D.EFFDT =
        (SELECT MAX(D_ED.EFFDT) FROM PS_TAX_DISTRIB D_ED
        WHERE D.EMPLID = D_ED.EMPLID
          AND D.EMPL_RCD = D_ED.EMPL_RCD
          AND D_ED.EFFDT <= SYSDATE)
     AND A.EMPLID = :1 ))
  GROUP BY  B.COMPANY,  A.EMPLID,  E.NAME,  A.STATE,  B.TAX_LOCATION_CD,  A.ASOFDATE,  B.EMPL_STATUS,  D.STATE,  D.LOCALITY,  B.EMPLID,  B.LOCATION,  B.PAYGROUP,  C.EMPLID,  C.COMPANY,  C.EFFDT,  C.STATE,  C.RESIDENT,  C.UI_JURISDICTION,  E.EMPLID,  E.FIRST_NAME,  E.LAST_NAME
