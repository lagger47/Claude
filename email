Option Explicit

'===========================================
' TARGET MAILBOX EMAIL FETCHING
' Fixed: Clean permission handling, true moved email detection
'===========================================

Public Function FetchEmails(startDate As Date, endDate As Date, targetMailbox As String, _
                            ByRef outSentConversations As Object, _
                            ByRef outMovedEmails As Object, _
                            ByRef outChainEmails As Object) As Collection
    
    Dim olApp As Object
    Dim olNS As Object
    Dim targetRecipient As Object
    Dim result As New Collection
    
    On Error Resume Next
    Set olApp = GetObject(, "Outlook.Application")
    If olApp Is Nothing Then
        Set olApp = CreateObject("Outlook.Application")
    End If
    On Error GoTo 0
    
    If olApp Is Nothing Then
        MsgBox "Could not connect to Outlook.", vbCritical
        End
    End If
    
    Set olNS = olApp.GetNamespace("MAPI")
    
    ' Resolve the TARGET mailbox
    Set targetRecipient = olNS.CreateRecipient(targetMailbox)
    targetRecipient.Resolve
    
    If Not targetRecipient.Resolved Then
        MsgBox "Cannot resolve mailbox: " & targetMailbox & vbCrLf & _
               "Check the email address and ensure you have permissions.", vbCritical
        End
    End If
    
    ' Initialize tracking dictionaries
    Set outSentConversations = CreateObject("Scripting.Dictionary")
    Set outMovedEmails = CreateObject("Scripting.Dictionary")
    Set outChainEmails = CreateObject("Scripting.Dictionary")
    
    ' Get target mailbox Sent Items - SILENT fallback
    Dim sentFolder As Object
    Dim bUseSharedSent As Boolean
    bUseSharedSent = False
    
    On Error Resume Next
    Set sentFolder = olNS.GetSharedDefaultFolder(targetRecipient, 5)
    If Err.Number = 0 And Not sentFolder Is Nothing Then
        bUseSharedSent = True
    End If
    Err.Clear
    On Error GoTo 0
    
    If bUseSharedSent Then
        BuildSentConversations sentFolder, startDate, endDate, outSentConversations
    Else
        ' Silently skip shared sent - will use conversation matching only
        ' No warning message
    End If
    
    ' Scan ONLY target mailbox folders
    Dim allEmails As Object
    Set allEmails = CreateObject("Scripting.Dictionary")
    
    Dim targetRoot As Object
    On Error Resume Next
    Set targetRoot = olNS.GetSharedDefaultFolder(targetRecipient, 6).Parent
    On Error GoTo 0
    
    If targetRoot Is Nothing Then
        MsgBox "Cannot access mailbox root for " & targetMailbox, vbCritical
        End
    End If
    
    ' Scan all folders under target mailbox
    ScanMailFolders targetRoot, startDate, endDate, allEmails, targetMailbox
    
    ' Process all found emails
    Dim convID As String
    Dim processedConversations As Object
    Set processedConversations = CreateObject("Scripting.Dictionary")
    
    ' First pass: build conversation index from ALL items (to detect chains)
    Dim emailKey As Variant
    For Each emailKey In allEmails.Keys
        Dim eData As Object
        Set eData = allEmails(emailKey)
        convID = eData("ConversationID")
        
        If Not outChainEmails.Exists(convID) Then
            outChainEmails.Add convID, 1
        Else
            outChainEmails(convID) = outChainEmails(convID) + 1
        End If
    Next emailKey
    
    ' Second pass: process unique conversations
    For Each emailKey In allEmails.Keys
        Set eData = allEmails(emailKey)
        convID = eData("ConversationID")
        
        If Not processedConversations.Exists(convID) Then
            processedConversations.Add convID, eData("FolderName")
            
            Dim rec As Object
            Set rec = CreateObject("Scripting.Dictionary")
            rec.Add "EntryID", CStr(eData("EntryID"))
            rec.Add "ConversationID", CStr(convID)
            rec.Add "SenderName", CStr(eData("SenderName"))
            rec.Add "SenderEmail", CStr(eData("SenderEmail"))
            rec.Add "Subject", CStr(eData("Subject"))
            rec.Add "ReceivedTime", CDate(eData("ReceivedTime"))
            rec.Add "CurrentFolder", CStr(eData("FolderName"))
            rec.Add "MailboxName", CStr(eData("MailboxName"))
            rec.Add "ChainLength", outChainEmails(convID)
            
            ' Check if NOT in Inbox (moved from default location)
            If LCase(eData("FolderName")) <> "inbox" Then
                rec("WasMoved") = True
                rec("OriginalLocation") = "Inbox (assumed)"
            Else
                rec("WasMoved") = False
                rec("OriginalLocation") = "Inbox"
            End If
            
            ' Check for replies
            If outSentConversations.Exists(convID) Then
                Dim replyColl As Collection
                Set replyColl = outSentConversations(convID)
                Dim firstReply As Date
                firstReply = GetFirstReplyTime(replyColl)
                
                rec("IsReply") = True
                rec("SentTime") = CDate(firstReply)
                rec("ReplyTimeMinutes") = CDbl(DateDiff("n", rec("ReceivedTime"), firstReply))
                rec("ReplyTimeHours") = CDbl(Round(rec("ReplyTimeMinutes") / 60, 2))
                rec("ReplyStatus") = "Replied"
                
                Dim businessMinutes As Double
                businessMinutes = WorkingHours24x7(rec("ReceivedTime"), rec("SentTime"))
                rec("BusinessMinutes") = businessMinutes
                rec("BusinessHours") = Round(businessMinutes / 60, 2)
                
                If businessMinutes <= 60 Then
                    rec("SLABucket") = "Within 1 Hour"
                ElseIf businessMinutes <= 240 Then
                    rec("SLABucket") = "Within 4 Hours"
                ElseIf businessMinutes <= 1440 Then
                    rec("SLABucket") = "Within 24 Hours"
                ElseIf businessMinutes <= 2880 Then
                    rec("SLABucket") = "Within 48 Hours (TAT)"
                Else
                    rec("SLABucket") = "Over 48 Hours (TAT Breach)"
                End If
            Else
                rec("IsReply") = False
                rec("SentTime") = CDate(0)
                rec("ReplyTimeMinutes") = CDbl(DateDiff("n", rec("ReceivedTime"), Now))
                rec("ReplyTimeHours") = CDbl(Round(rec("ReplyTimeMinutes") / 60, 2))
                rec("ReplyStatus") = "Not Replied"
                rec("BusinessMinutes") = 0
                rec("BusinessHours") = 0
                rec("SLABucket") = "No Reply"
            End If
            
            ' Forward detection
            If outSentConversations.Exists(convID) Then
                Dim fwdCheck As Object
                Set fwdCheck = outSentConversations(convID)(1)
                If InStr(LCase(CStr(fwdCheck.Subject)), "fw:") > 0 Then
                    rec("WasForwarded") = True
                Else
                    rec("WasForwarded") = False
                End If
            Else
                rec("WasForwarded") = False
            End If
            
            result.Add rec
        Else
            ' Same conversation found in different folder - TRUE moved email
            If Not outMovedEmails.Exists(convID) Then
                outMovedEmails.Add convID, CreateObject("Scripting.Dictionary")
                outMovedEmails(convID).Add "From", processedConversations(convID)
                outMovedEmails(convID).Add "To", eData("FolderName")
                outMovedEmails(convID).Add "Subject", eData("Subject")
                outMovedEmails(convID).Add "Mailbox", eData("MailboxName")
            Else
                ' Update if found in yet another folder
                outMovedEmails(convID)("To") = outMovedEmails(convID)("To") & ", " & eData("FolderName")
            End If
        End If
    Next emailKey
    
    Set FetchEmails = result
    Set olNS = Nothing
    Set olApp = Nothing
End Function

Private Sub BuildSentConversations(sentFolder As Object, startDate As Date, endDate As Date, _
                                  ByRef sentConversations As Object)
    Dim filterStr As String
    filterStr = "[SentOn] >= \'" & Format(startDate, "ddddd h:nn AMPM") & "\' AND " & _
                "[SentOn] < \'" & Format(endDate + 1, "ddddd h:nn AMPM") & "\'"
    
    Dim sentItems As Object
    Set sentItems = sentFolder.items
    
    On Error Resume Next
    sentItems.Sort "[SentOn]", True
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    
    Dim filteredSent As Object
    On Error Resume Next
    Set filteredSent = sentItems.Restrict(filterStr)
    If Err.Number <> 0 Then
        Set filteredSent = sentItems
        Err.Clear
    End If
    On Error GoTo 0
    
    Dim sentMail As Object
    Dim convID As String
    
    For Each sentMail In filteredSent
        If sentMail.Class = 43 Then
            convID = sentMail.ConversationID
            If Not sentConversations.Exists(convID) Then
                sentConversations.Add convID, New Collection
            End If
            sentConversations(convID).Add sentMail
        End If
    Next sentMail
End Sub

Private Sub ScanMailFolders(folder As Object, startDate As Date, endDate As Date, _
                            ByRef allEmails As Object, mailboxName As String)
    
    Dim folderType As Integer
    On Error Resume Next
    folderType = folder.DefaultItemType
    On Error GoTo 0
    
    If folderType = 0 Or folderType = 1 Then
        Dim filterStr As String
        filterStr = "[Received] >= \'" & Format(startDate, "ddddd h:nn AMPM") & "\' AND " & _
                    "[Received] < \'" & Format(endDate + 1, "ddddd h:nn AMPM") & "\'"
        
        Dim items As Object
        Set items = folder.items
        
        On Error Resume Next
        items.Sort "[Received]", True
        If Err.Number <> 0 Then Err.Clear
        On Error GoTo 0
        
        Dim filteredItems As Object
        On Error Resume Next
        Set filteredItems = items.Restrict(filterStr)
        If Err.Number <> 0 Then
            Set filteredItems = items
            Err.Clear
        End If
        On Error GoTo 0
        
        Dim item As Object
        Dim idx As Long
        idx = 1
        
        For Each item In filteredItems
            If item.Class = 43 Then
                Dim recTime As Date
                Dim subj As String
                Dim sndName As String
                Dim sndEmail As String
                Dim entryID As String
                Dim conv As String
                
                On Error Resume Next
                recTime = item.ReceivedTime
                If Err.Number <> 0 Then
                    recTime = item.CreationTime
                    Err.Clear
                End If
                
                subj = item.Subject
                If Err.Number <> 0 Then subj = "": Err.Clear
                
                sndName = item.SenderName
                If Err.Number <> 0 Then sndName = "Unknown": Err.Clear
                
                sndEmail = item.SenderEmailAddress
                If Err.Number <> 0 Then sndEmail = "": Err.Clear
                
                entryID = item.entryID
                If Err.Number <> 0 Then entryID = "": Err.Clear
                
                conv = item.ConversationID
                If Err.Number <> 0 Then conv = "": Err.Clear
                On Error GoTo 0
                
                If recTime >= startDate And recTime < (endDate + 1) Then
                    Dim emailData As Object
                    Set emailData = CreateObject("Scripting.Dictionary")
                    emailData.Add "EntryID", entryID
                    emailData.Add "ConversationID", conv
                    emailData.Add "SenderName", sndName
                    emailData.Add "SenderEmail", sndEmail
                    emailData.Add "Subject", subj
                    emailData.Add "ReceivedTime", recTime
                    emailData.Add "FolderName", folder.Name
                    emailData.Add "MailboxName", mailboxName
                    
                    allEmails.Add entryID & "_" & idx, emailData
                    idx = idx + 1
                End If
            End If
        Next item
    End If
    
    Dim subFolder As Object
    For Each subFolder In folder.Folders
        ScanMailFolders subFolder, startDate, endDate, allEmails, mailboxName
    Next subFolder
End Sub

Private Function GetFirstReplyTime(replyColl As Collection) As Date
    Dim earliest As Date
    Dim mail As Object
    earliest = #12/31/9999#
    
    For Each mail In replyColl
        If mail.SentOn < earliest Then
            earliest = mail.SentOn
        End If
    Next mail
    
    GetFirstReplyTime = earliest
End Function

Public Function WorkingHours24x7(startTime As Date, endTime As Date) As Double
    Dim totalMinutes As Double
    Dim currentDay As Date
    Dim dayStart As Date
    Dim dayEnd As Date
    
    totalMinutes = 0
    currentDay = Int(startTime)
    
    Do While currentDay <= Int(endTime)
        Dim wd As Integer
        wd = Weekday(currentDay)
        
        If wd <> 1 And wd <> 7 Then
            If currentDay = Int(startTime) Then
                dayStart = startTime
            Else
                dayStart = currentDay
            End If
            
            If currentDay = Int(endTime) Then
                dayEnd = endTime
            Else
                dayEnd = currentDay + 1
            End If
            
            If dayEnd > dayStart Then
                totalMinutes = totalMinutes + DateDiff("n", dayStart, dayEnd)
            End If
        End If
        
        currentDay = currentDay + 1
    Loop
    
    WorkingHours24x7 = totalMinutes
End Function





