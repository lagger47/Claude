Public Sub LaunchDashboard()
    Dim startDate As Date
    Dim endDate As Date
    Dim mailbox As String
    Dim todayOnly As VbMsgBoxResult
    
    todayOnly = MsgBox("Generate report for TODAY only?" & vbCrLf & vbCrLf & _
                       "Click YES for today only" & vbCrLf & _
                       "Click NO to select a date range", vbYesNoCancel + vbQuestion, "Email Dashboard")
    
    If todayOnly = vbCancel Then Exit Sub
    
    If todayOnly = vbYes Then
        startDate = Date
        endDate = Date
    Else
        Dim sStart As String, sEnd As String
        sStart = InputBox("Enter START date (dd-mmm-yyyy):", "Date Range", Format(Date, "dd-mmm-yyyy"))
        If sStart = "" Then Exit Sub
        sEnd = InputBox("Enter END date (dd-mmm-yyyy):", "Date Range", Format(Date, "dd-mmm-yyyy"))
        If sEnd = "" Then Exit Sub
        
        On Error Resume Next
        startDate = CDate(sStart)
        endDate = CDate(sEnd)
        On Error GoTo 0
        
        If startDate = 0 Or endDate = 0 Then
            MsgBox "Invalid date format. Use dd-mmm-yyyy (e.g., 01-Jun-2026)", vbExclamation
            Exit Sub
        End If
    End If
    
    mailbox = InputBox("Enter target mailbox email (group or personal):", "Mailbox", "group@company.com")
    If mailbox = "" Then Exit Sub
    
    modDashboardEngine.GenerateDashboard startDate, endDate, mailbox
End Sub

