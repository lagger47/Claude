'--- File pickers ------------------------------------------------------------
Public Function PickWorkbook(ByVal title As String) As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .title = title
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel files", "*.xls; *.xlsx; *.xlsm; *.xlsb; *.csv; *.txt"
        If .Show = -1 Then PickWorkbook = .SelectedItems(1) Else PickWorkbook = ""
    End With
End Function

Public Function PickFolder(ByVal title As String) As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    With fd
        .title = title
        If .Show = -1 Then PickFolder = .SelectedItems(1) Else PickFolder = ""
    End With
End Function

'--- Open a workbook if it is not already open -------------------------------
Public Function OpenOrGet(ByVal fullPath As String, Optional ByVal readOnlyMode As Boolean = False) As Workbook
    Dim wb As Workbook, nm As String
    If Len(Dir$(fullPath)) = 0 Then Err.Raise vbObjectError + 100, , "File not found: " & fullPath
    nm = Mid$(fullPath, InStrRev(fullPath, "\") + 1)
    On Error Resume Next
    Set wb = Application.Workbooks(nm)
    On Error GoTo 0
    If wb Is Nothing Then
        Set wb = Application.Workbooks.Open(Filename:=fullPath, ReadOnly:=readOnlyMode, UpdateLinks:=0)
    End If
    Set OpenOrGet = wb
End Function

'--- Speed toggles -----------------------------------------------------------
Public Sub FastMode(ByVal onOff As Boolean)
    With Application
        .ScreenUpdating = Not onOff
        .EnableEvents = Not onOff
        .DisplayAlerts = Not onOff
        .Calculation = IIf(onOff, xlCalculationManual, xlCalculationAutomatic)
    End With
End Sub

'--- Token replacement for the file name pattern -----------------------------
Public Function ExpandPattern(ByVal pattern As String, ByVal d As Date) As String
    Dim s As String
    s = pattern
    s = Replace(s, "{MMMM}", Format$(d, "mmmm"))
    s = Replace(s, "{MMM}", Format$(d, "mmm"))
    s = Replace(s, "{MM}", Format$(d, "mm"))
    s = Replace(s, "{DD}", Format$(d, "dd"))
    s = Replace(s, "{YYYY}", Format$(d, "yyyy"))
    s = Replace(s, "{WK}", Format$(Application.WorksheetFunction.IsoWeekNum(d), "00"))
    ExpandPattern = s
End Function

