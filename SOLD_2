Public Sub Stage1_CreateSoldFile()
    Dim fundPath As String, prevPath As String, outFolder As String
    Dim newName As String, newPath As String, ext As String
    Dim wbFund As Workbook

    fundPath = Cfg("FUNDING_FILE_PATH")
    If Len(fundPath) = 0 Or Len(Dir$(fundPath)) = 0 Then
        fundPath = PickWorkbook("Select this week's FUNDING FILE")
        If Len(fundPath) = 0 Then Err.Raise vbObjectError + 1, , "No Funding File selected."
        CfgSet "FUNDING_FILE_PATH", fundPath
    End If

    prevPath = Cfg("PREV_SOLD_PATH")
    If Len(prevPath) = 0 Or Len(Dir$(prevPath)) = 0 Then
        prevPath = PickWorkbook("Select LAST WEEK'S SOLD FILE (used as the formatting reference)")
        If Len(prevPath) = 0 Then Err.Raise vbObjectError + 2, , "No previous SOLD FILE selected."
        CfgSet "PREV_SOLD_PATH", prevPath
    End If

    outFolder = Cfg("OUTPUT_FOLDER")
    If Len(outFolder) = 0 Then outFolder = Left$(fundPath, InStrRev(fundPath, "\") - 1)
    If Right$(outFolder, 1) <> "\" Then outFolder = outFolder & "\"

    newName = ExpandPattern(Cfg("FILE_NAME_PATTERN", "MUFG SOLD FILE {MM}"), Date)
    newName = InputBox("Confirm the file name for this week's SOLD FILE:", "Step 1 - Save As", newName)
    If Len(Trim$(newName)) = 0 Then Err.Raise vbObjectError + 3, , "Save As cancelled."

    newPath = outFolder & newName & ".xlsx"
    If Len(Dir$(newPath)) > 0 Then
        If MsgBox(newName & ".xlsx already exists in" & vbCrLf & outFolder & vbCrLf & vbCrLf & _
                  "Overwrite it?", vbQuestion + vbYesNo, "Step 1") <> vbYes Then
            Err.Raise vbObjectError + 4, , "User declined to overwrite the existing file."
        End If
        Kill newPath
    End If

    FastMode True
    Set wbFund = OpenOrGet(fundPath, True)
    wbFund.SaveCopyAs newPath
    If wbFund.FullName <> ThisWorkbook.FullName Then wbFund.Close SaveChanges:=False
    FastMode False

    CfgSet "CURRENT_SOLD_PATH", newPath
    LogWrite "STEP 1", "DONE", "Created " & newPath

    Dim wbNew As Workbook, dataName As String
    Set wbNew = OpenOrGet(newPath)
    dataName = Cfg("DATA_SHEET_NAME", "DATA")
    If CfgBool("RENAME_FUNDING_SHEET", True) Then
        If Not SoldUtil_SheetExists(wbNew, dataName) Then
            If wbNew.Worksheets.Count = 1 Then
                wbNew.Worksheets(1).Name = dataName
                wbNew.Save
                LogWrite "STEP 1", "DONE", "Renamed the Funding File sheet to '" & dataName & "'."
            Else
                LogWrite "STEP 1", "CHECK", "No '" & dataName & "' sheet and more than one sheet present - rename it manually."
            End If
        End If
    End If
    wbNew.Activate
    MsgBox "This week's SOLD FILE has been created and opened:" & vbCrLf & vbCrLf & newPath & vbCrLf & vbCrLf & _
           "Confirm the DATA sheet name on CONFIG if it is not '" & Cfg("DATA_SHEET_NAME", "DATA") & "', " & _
           "then press RUN NEXT STEP.", vbInformation, "Step 1 complete"
End Sub

'==============================================================================
' STAGE 2  -  SOP Steps 2 to 5
' Insert 4 rows, copy headers A:AT, copy the orange formula columns and fill
' down, copy the AV6:AV11 block.
'==============================================================================
Public Sub Stage2_FrameAndFormulas()
    Dim wbCur As Workbook, wbPrev As Workbook
    Dim wsCur As Worksheet, wsPrev As Worksheet
    Dim nIns As Long, hdrRow As Long, firstRow As Long, lastCol As Long
    Dim lastRow As Long, cols() As String, i As Long, c As Long
    Dim auxRng As String, copied As String

    Set wbCur = CurrentSoldBook()
    Set wbPrev = PrevSoldBook()
    Set wsCur = DataSheet(wbCur)
    Set wsPrev = DataSheet(wbPrev)

    nIns = CfgLong("ROWS_TO_INSERT", 4)
    hdrRow = CfgLong("HEADER_ROW", 5)
    firstRow = CfgLong("FIRST_DATA_ROW", 6)
    lastCol = ColNum(Cfg("LAST_HEADER_COL", "AT"))

    FastMode True

    '--- Step 2: insert rows from the top ------------------------------------
    If Not AlreadyFramed(wsCur, hdrRow) Then
        wsCur.Rows("1:" & nIns).Insert Shift:=xlDown, CopyOrigin:=xlFormatFromLeftOrAbove
        LogWrite "STEP 2", "DONE", nIns & " rows inserted above the data."
    Else
        LogWrite "STEP 2", "SKIP", "Rows already inserted - header row " & hdrRow & " is populated."
    End If

    '--- Step 4 prep: bring the orange banner rows across ---------------------
    Dim r1 As Long, r2 As Long
    CfgRowRange "ORANGE_ROWS", r1, r2
    If CfgBool("COPY_ORANGE_BANNER", True) Then
        If r2 >= hdrRow Then r2 = hdrRow - 1
        wsPrev.Range(wsPrev.Cells(r1, 1), wsPrev.Cells(r2, lastCol)).Copy
        wsCur.Cells(r1, 1).PasteSpecial xlPasteAll
        Application.CutCopyMode = False
        LogWrite "STEP 2", "DONE", "Orange banner rows " & r1 & ":" & r2 & _
                              " copied across (A:" & Cfg("LAST_HEADER_COL", "AT") & ")."
    End If

    '--- Step 3: copy headers A:AT from the previous SOLD FILE ---------------
    wsPrev.Range(wsPrev.Cells(hdrRow, 1), wsPrev.Cells(hdrRow, lastCol)).Copy
    wsCur.Cells(hdrRow, 1).PasteSpecial xlPasteAll
    Application.CutCopyMode = False
    LogWrite "STEP 3", "DONE", "Headers copied A:" & Cfg("LAST_HEADER_COL", "AT")

    '--- Step 4: copy the orange formula columns and fill down ---------------
    lastRow = LastRowSpan(wsCur, "A", "W")
    If lastRow < firstRow Then lastRow = LastRowSpan(wsCur, "A", Cfg("LAST_HEADER_COL", "AT"))
    If lastRow < firstRow Then Err.Raise vbObjectError + 10, , "No data rows found on '" & wsCur.Name & "'."

    cols = FormulaColumns(wsPrev, firstRow, lastCol)
    copied = ""
    For i = LBound(cols) To UBound(cols)
        If Len(cols(i)) > 0 Then
            c = ColNum(cols(i))
            wsPrev.Cells(firstRow, c).Copy
            wsCur.Range(wsCur.Cells(firstRow, c), wsCur.Cells(lastRow, c)).PasteSpecial xlPasteFormulas
            wsPrev.Cells(firstRow, c).Copy
            wsCur.Range(wsCur.Cells(firstRow, c), wsCur.Cells(lastRow, c)).PasteSpecial xlPasteFormats
            copied = copied & cols(i) & " "
        End If
    Next i
    Application.CutCopyMode = False
    LogWrite "STEP 4", "DONE", "Formula columns filled to row " & lastRow & ": " & Trim$(copied)

    '--- Step 5: copy the AV6:AV11 side block --------------------------------
    auxRng = Cfg("AUX_FORMULA_RANGE", "AV6:AV11")
    If Len(auxRng) > 0 Then
        wsPrev.Range(auxRng).Copy
        wsCur.Range(auxRng).PasteSpecial xlPasteAll
        Application.CutCopyMode = False
        LogWrite "STEP 5", "DONE", "Copied " & auxRng
    End If

    wsCur.Range(wsCur.Cells(hdrRow, 1), wsCur.Cells(hdrRow, lastCol)).Font.Bold = True
    wbCur.Save
    FastMode False

    wsCur.Activate
    wsCur.Cells(hdrRow, 1).Select
    MsgBox "Steps 2 to 5 complete." & vbCrLf & vbCrLf & _
           "Header row : " & hdrRow & vbCrLf & _
           "Data rows  : " & firstRow & " to " & lastRow & vbCrLf & _
           "Formula cols: " & Trim$(copied) & vbCrLf & vbCrLf & _
           "Please eyeball the orange section before continuing, then press RUN NEXT STEP.", _
           vbInformation, "Stage 2 complete"
End Sub

'--- Decide which columns carry the orange formulas -------------------------
Private Function FormulaColumns(wsPrev As Worksheet, ByVal firstRow As Long, ByVal lastCol As Long) As String()
    Dim setting As String, out() As String, n As Long, c As Long
    Dim r1 As Long, r2 As Long
    Dim isOrange As Boolean, anyOrange As Boolean, r As Long

    setting = UCase$(Cfg("FORMULA_COLS", "AUTO"))
    If setting <> "AUTO" And Len(setting) > 0 Then
        FormulaColumns = Split(Replace(Replace(setting, " ", ""), ";", ","), ",")
        Exit Function
    End If

    CfgRowRange "ORANGE_ROWS", r1, r2
    If r2 >= firstRow Then r2 = firstRow - 2
    If r2 < r1 Then r2 = r1

    ' Pass 1 - is any column banded in the orange rows at all?
    For c = 1 To lastCol
        For r = r1 To r2
            If wsPrev.Cells(r, c).Interior.ColorIndex <> xlNone Then anyOrange = True: Exit For
        Next r
        If anyOrange Then Exit For
    Next c

    ReDim out(0 To lastCol)
    n = -1
    For c = 1 To lastCol
        isOrange = False
        If anyOrange Then
            For r = r1 To r2
                If wsPrev.Cells(r, c).Interior.ColorIndex <> xlNone Then isOrange = True: Exit For
            Next r
        Else
            isOrange = True                      ' no banding found - fall back to formulas only
        End If
        If isOrange And wsPrev.Cells(firstRow, c).HasFormula Then
            n = n + 1
            out(n) = ColLtr(c)
        End If
    Next c

    If n < 0 Then
        ReDim out(0 To 0)
        out(0) = ""
        LogWrite "STEP 4", "CHECK", "No formula columns detected under the orange section."
    Else
        ReDim Preserve out(0 To n)
    End If
    FormulaColumns = out
End Function

Private Function AlreadyFramed(ws As Worksheet, ByVal hdrRow As Long) As Boolean
    Dim above As Boolean
    above = (Application.WorksheetFunction.CountA(ws.Rows(1)) = 0)
    AlreadyFramed = above And (Application.WorksheetFunction.CountA(ws.Rows(hdrRow)) > 0)
End Function

'==============================================================================
' STAGE 3  -  SOP Step 6
' Convert the Invoice ID column to text and push the document numbers to the
' Windows clipboard, ready for the SAP multiple-selection paste.
'==============================================================================
Public Sub Stage3_DocNumbersToClipboard()
    Dim wb As Workbook, ws As Worksheet
    Dim invCol As String, c As Long, firstRow As Long, lastRow As Long
    Dim hdrRow As Long, lastCol As Long
    Dim r As Long, v As String, sb As String, cnt As Long
    Dim arr As Variant

    Set wb = CurrentSoldBook()
    Set ws = DataSheet(wb)
    invCol = Cfg("INVOICE_ID_COL", "X")
    c = ColNum(invCol)
    hdrRow = CfgLong("HEADER_ROW", 5)
    firstRow = CfgLong("FIRST_DATA_ROW", 6)
    lastCol = ColNum(Cfg("LAST_HEADER_COL", "AT"))
    lastRow = LastRowSpan(ws, "A", Cfg("LAST_HEADER_COL", "AT"))
    If lastRow < firstRow Then Err.Raise vbObjectError + 20, , "No data rows found."

    FastMode True
    arr = ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).value

    ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).NumberFormat = "@"
    For r = 1 To UBound(arr, 1)
        v = Trim$(CStr(arr(r, 1)))
        If Len(v) > 0 Then
            If InStr(v, "E+") > 0 Or InStr(v, "e+") > 0 Then
                v = Format$(CDbl(arr(r, 1)), "0")
            End If
            arr(r, 1) = v
            sb = sb & v & vbCrLf
            cnt = cnt + 1
        Else
            arr(r, 1) = ""
        End If
    Next r
    ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).value = arr
    ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).HorizontalAlignment = xlLeft

    '--- sort smallest to largest on the Invoice ID --------------------------
    On Error Resume Next
    ws.AutoFilterMode = False
    On Error GoTo 0
    With ws.Sort
        .SortFields.Clear
        .SortFields.Add key:=ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)), _
                        SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortTextAsNumbers
        .SetRange ws.Range(ws.Cells(hdrRow, 1), ws.Cells(lastRow, lastCol))
        .Header = xlYes
        .Apply
    End With
    LogWrite "STEP 6", "DONE", "Sorted " & (lastRow - firstRow + 1) & _
                         " rows ascending on column " & invCol & " before copying."

    '--- rebuild the clipboard string FROM THE SORTED ORDER ------------------
    sb = ""
    cnt = 0
    arr = ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).value
    For r = 1 To UBound(arr, 1)
        v = Trim$(CStr(arr(r, 1)))
        If Len(v) > 0 Then
            sb = sb & v & vbCrLf
            cnt = cnt + 1
        End If
    Next r

    wb.Save
    FastMode False

    If Not PutOnClipboard(sb) Then
        LogWrite "STEP 6", "CHECK", "Clipboard load failed - copy column " & invCol & " manually."
        MsgBox "Column " & invCol & " has been converted to text, but the clipboard could not be loaded." & vbCrLf & _
               "Select " & invCol & firstRow & ":" & invCol & lastRow & " and press Ctrl+C yourself.", _
               vbExclamation, "Step 6"
    Else
        LogWrite "STEP 6", "DONE", cnt & " document numbers converted to text and copied to the clipboard."
    End If

    ws.Activate
    ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).Select
End Sub

