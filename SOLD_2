Public Sub SOLD_Setup()
    EnsureConfigSheet
    EnsureStateSheet
    EnsureLogSheet
    BuildControlPanel
    ThisWorkbook.Worksheets(PANEL_SHEET).Activate
    MsgBox "SOLD FILE tool is ready." & vbCrLf & vbCrLf & _
           "1. Open the CONFIG sheet and fill in REPAYMENT_DATE_COL (and check the other column letters)." & vbCrLf & _
           "2. Come back to the CONTROL PANEL and press RUN NEXT STEP.", _
           vbInformation, "SOLD FILE Builder"
End Sub

'--- The single button the user presses over and over ------------------------
Public Sub SOLD_RunNextStep()
    Dim stg As Long, problems As String

    EnsureConfigSheet
    EnsureStateSheet
    EnsureLogSheet

    If Not ValidateConfig(problems) Then
        MsgBox "The CONFIG sheet is not complete yet:" & vbCrLf & vbCrLf & problems, _
               vbExclamation, "SOLD FILE Builder"
        ThisWorkbook.Worksheets(CFG_SHEET).Activate
        Exit Sub
    End If

    stg = GetStage()
    If stg >= STAGE_COUNT Then
        MsgBox "All stages are complete." & vbCrLf & _
               "Use RESET to start a new week.", vbInformation, "SOLD FILE Builder"
        Exit Sub
    End If

    RunStage stg + 1
End Sub

'--- Re-run the stage that was just completed --------------------------------
Public Sub SOLD_RepeatLastStep()
    Dim stg As Long
    stg = GetStage()
    If stg < 1 Then
        MsgBox "Nothing has been run yet.", vbInformation, "SOLD FILE Builder"
        Exit Sub
    End If
    SetStage stg - 1
    RunStage stg
End Sub

'--- Start a fresh week ------------------------------------------------------
Public Sub SOLD_Reset()
    If MsgBox("Reset the process back to Stage 0?" & vbCrLf & _
              "File paths on CONFIG are kept; the stage marker and log are cleared.", _
              vbQuestion + vbYesNo, "SOLD FILE Builder") <> vbYes Then Exit Sub
    SetStage 0
    CfgSet "CURRENT_SOLD_PATH", ""
    CfgSet "SAP_EXPORT_PATH", ""
    ClearLog
    RefreshPanel
    MsgBox "Reset complete.", vbInformation, "SOLD FILE Builder"
End Sub

'--- Jump to an arbitrary stage (recovery) -----------------------------------
Public Sub SOLD_GoToStage()
    Dim s As String, n As Long
    s = InputBox("Set the stage marker to which completed stage number? (0-" & STAGE_COUNT & ")", _
                 "SOLD FILE Builder", CStr(GetStage()))
    If Len(s) = 0 Then Exit Sub
    If Not IsNumeric(s) Then Exit Sub
    n = CLng(s)
    If n < 0 Or n > STAGE_COUNT Then Exit Sub
    SetStage n
    RefreshPanel
End Sub

'==============================================================================
' STAGE ROUTER
'==============================================================================
Private Sub RunStage(ByVal stg As Long)
    On Error GoTo Fail
    LogWrite "STAGE " & stg, "START", StageName(stg)

    Select Case stg
        Case 1: Stage1_CreateSoldFile          ' Step 1
        Case 2: Stage2_FrameAndFormulas        ' Steps 2-5
        Case 3: Stage3_DocNumbersToClipboard   ' Step 6
        Case 4: Stage4_SapInstructions           ' Steps 7-11  (MANUAL)
        Case 5: Stage5_ImportSapExtract          ' Steps 12-15
        Case 6: Stage6_CleanUpColumns            ' Steps 16-18
        Case 7: Stage7_RefKey1                   ' Step 19
        Case 8: Stage8_BuildLSMW              ' Steps 20-23
        Case 9: Stage9_BuildSummary           ' Steps 24-27
    End Select

    SetStage stg
    LogWrite "STAGE " & stg, "DONE", StageName(stg)
    RefreshPanel
    Exit Sub

Fail:
    FastMode False
    LogWrite "STAGE " & stg, "ERROR", Err.Number & " - " & Err.Description
    RefreshPanel
    MsgBox "Stage " & stg & " (" & StageName(stg) & ") stopped." & vbCrLf & vbCrLf & _
           Err.Number & " - " & Err.Description & vbCrLf & vbCrLf & _
           "The stage marker has NOT moved forward. Fix the issue and press RUN NEXT STEP again.", _
           vbCritical, "SOLD FILE Builder"
End Sub

