Public Function SoldUtil_GetOrCreateSheet(wb As Workbook, ByVal shName As String) As Worksheet
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(shName)
    On Error GoTo 0
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = shName
    End If
    Set SoldUtil_GetOrCreateSheet = ws
End Function

Public Function SoldUtil_SheetExists(wb As Workbook, ByVal shName As String) As Boolean
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(shName)
    On Error GoTo 0
    SoldUtil_SheetExists = Not ws Is Nothing
End Function

'--- Columns -----------------------------------------------------------------
Public Function ColNum(ByVal colLetter As String) As Long
    Dim s As String, i As Long, ch As Long, n As Long
    s = UCase$(Trim$(colLetter))
    If Len(s) = 0 Or Len(s) > 3 Then Exit Function
    For i = 1 To Len(s)
        ch = Asc(Mid$(s, i, 1)) - 64
        If ch < 1 Or ch > 26 Then ColNum = 0: Exit Function
        n = n * 26 + ch
    Next i
    ColNum = n
End Function

Public Function ColLtr(ByVal colNumber As Long) As String
    Dim n As Long, r As Long, s As String
    n = colNumber
    Do While n > 0
        r = ((n - 1) Mod 26)
        s = Chr$(65 + r) & s
        n = (n - r - 1) \ 26
    Loop
    ColLtr = s
End Function

'--- Last used row within a specific column ---------------------------------
Public Function LastRowIn(ws As Worksheet, ByVal colLetter As String) As Long
    LastRowIn = ws.Cells(ws.Rows.Count, ColNum(colLetter)).End(xlUp).Row
End Function

'--- Last used row across a span of columns ---------------------------------
Public Function LastRowSpan(ws As Worksheet, ByVal firstCol As String, ByVal lastCol As String) As Long
    Dim c As Long, r As Long, mx As Long
    For c = ColNum(firstCol) To ColNum(lastCol)
        r = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
        If r > mx Then mx = r
    Next c
    LastRowSpan = mx
End Function

'--- Find a header cell in the header row -----------------------------------
Public Function FindHeader(ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Range
    Dim lastCol As Long, c As Long, v As String
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = Trim$(CStr(ws.Cells(headerRow, c).value))
        If StrComp(v, Trim$(headerText), vbTextCompare) = 0 Then
            Set FindHeader = ws.Cells(headerRow, c)
            Exit Function
        End If
    Next c
    Set FindHeader = Nothing
End Function

'==============================================================================
' Robust date parser - deliberately does NOT rely on CDate, so that the macro
' behaves the same on an Indian regional setting as on a US one.
' Handles: dd.mm.yyyy  dd/mm/yyyy  dd-mm-yyyy  yyyy-mm-dd  yyyymmdd  ddmmyyyy
'          and real Excel date serials.
'==============================================================================
Public Function ParseAnyDate(ByVal v As Variant, Optional ByVal preferDayFirst As Boolean = True) As Variant
    Dim s As String, parts() As String, i As Long
    Dim d As Long, m As Long, y As Long
    Dim sep As String

    ParseAnyDate = Empty
    If IsEmpty(v) Then Exit Function

    If IsDate(v) And VarType(v) = vbDate Then
        ParseAnyDate = CDate(v): Exit Function
    End If

    If IsNumeric(v) Then
        Dim n As Double
        n = CDbl(v)
        If n > 20000 And n < 60000 Then          ' plausible Excel serial
            ParseAnyDate = CDate(n): Exit Function
        End If
    End If

    s = Trim$(CStr(v))
    If Len(s) = 0 Then Exit Function
    s = Replace(s, Chr$(160), " ")
    s = Trim$(s)

    sep = ""
    If InStr(s, ".") > 0 Then sep = "."
    If InStr(s, "/") > 0 Then sep = "/"
    If InStr(s, "-") > 0 Then sep = "-"

    If sep <> "" Then
        parts = Split(s, sep)
        If UBound(parts) <> 2 Then Exit Function
        For i = 0 To 2
            parts(i) = Trim$(parts(i))
            If Not IsNumeric(parts(i)) Then Exit Function
        Next i
        If Len(parts(0)) = 4 Then                 ' yyyy-mm-dd
            y = CLng(parts(0)): m = CLng(parts(1)): d = CLng(parts(2))
        Else
            If preferDayFirst Then
                d = CLng(parts(0)): m = CLng(parts(1)): y = CLng(parts(2))
            Else
                m = CLng(parts(0)): d = CLng(parts(1)): y = CLng(parts(2))
            End If
            ' self-correct an obvious mm/dd file
            If m > 12 And d <= 12 Then
                Dim t As Long: t = d: d = m: m = t
            End If
        End If
    ElseIf Len(s) = 8 And IsNumeric(s) Then
        If Left$(s, 2) = "19" Or Left$(s, 2) = "20" Then   ' yyyymmdd
            y = CLng(Left$(s, 4)): m = CLng(Mid$(s, 5, 2)): d = CLng(Right$(s, 2))
        Else                                               ' ddmmyyyy
            d = CLng(Left$(s, 2)): m = CLng(Mid$(s, 3, 2)): y = CLng(Right$(s, 4))
        End If
    Else
        Exit Function
    End If

    If y < 100 Then y = IIf(y < 70, 2000 + y, 1900 + y)
    If m < 1 Or m > 12 Then Exit Function
    If d < 1 Or d > 31 Then Exit Function

    On Error Resume Next
    ParseAnyDate = DateSerial(y, m, d)
    If Err.Number <> 0 Then ParseAnyDate = Empty: Err.Clear
    On Error GoTo 0
End Function

