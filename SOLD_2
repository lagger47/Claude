Private Function PutDef(ws As Worksheet, r As Long, k As String, v As String, n As String) As Long
    ws.Cells(r, 1).value = k
    ws.Cells(r, 2).value = v
    ws.Cells(r, 3).value = n
    ws.Cells(r, 2).HorizontalAlignment = xlLeft
    PutDef = r + 1
End Function

'--- Read a config value -----------------------------------------------------
Public Function Cfg(ByVal key As String, Optional ByVal defaultValue As String = "") As String
    Dim ws As Worksheet, f As Range
    EnsureConfigSheet
    Set ws = ThisWorkbook.Worksheets(CFG_SHEET)
    Set f = ws.Columns(1).Find(What:=key, LookIn:=xlValues, LookAt:=xlWhole, MatchCase:=False)
    If f Is Nothing Then
        Cfg = defaultValue
    Else
        Cfg = Trim$(CStr(f.Offset(0, 1).value))
        If Len(Cfg) = 0 Then Cfg = defaultValue
    End If
End Function

Public Function CfgLong(ByVal key As String, Optional ByVal defaultValue As Long = 0) As Long
    Dim s As String
    s = Cfg(key, CStr(defaultValue))
    If IsNumeric(s) Then CfgLong = CLng(s) Else CfgLong = defaultValue
End Function

Public Function CfgBool(ByVal key As String, Optional ByVal defaultValue As Boolean = False) As Boolean
    Dim s As String
    s = UCase$(Cfg(key, IIf(defaultValue, "TRUE", "FALSE")))
    CfgBool = (s = "TRUE" Or s = "YES" Or s = "1" Or s = "Y")
End Function

'--- Write a config value back ----------------------------------------------
'--- Read an "a:b" row range, surviving a cell Excel turned into a time -------
Public Sub CfgRowRange(ByVal key As String, ByRef r1 As Long, ByRef r2 As Long)
    Dim raw As String, parts() As String
    Dim fallback1 As Long, fallback2 As Long

    fallback1 = 1
    fallback2 = CfgLong("HEADER_ROW", 5) - 1
    If fallback2 < fallback1 Then fallback2 = fallback1

    raw = Cfg(key, "")
    If InStr(raw, ":") > 0 Then
        parts = Split(raw, ":")
        If UBound(parts) >= 1 Then
            If IsNumeric(Trim$(parts(0))) And IsNumeric(Trim$(parts(1))) Then
                r1 = CLng(Trim$(parts(0)))
                r2 = CLng(Trim$(parts(1)))
                If r1 >= 1 And r2 >= r1 Then Exit Sub
            End If
        End If
    End If

    ' unreadable (blank, or Excel coerced it to a time) - derive it instead
    r1 = fallback1
    r2 = fallback2
End Sub

'--- Read an "AA:AN" column span, with a safe fallback -----------------------
Public Sub CfgColSpan(ByVal key As String, ByVal defaultSpec As String, _
                      ByRef c1 As Long, ByRef c2 As Long)
    Dim raw As String, parts() As String
    raw = Cfg(key, defaultSpec)
    If InStr(raw, ":") = 0 Then raw = defaultSpec
    parts = Split(raw, ":")
    If UBound(parts) < 1 Then parts = Split(defaultSpec, ":")
    c1 = ColNum(Trim$(parts(0)))
    c2 = ColNum(Trim$(parts(1)))
    If c1 = 0 Or c2 = 0 Or c2 < c1 Then
        parts = Split(defaultSpec, ":")
        c1 = ColNum(Trim$(parts(0)))
        c2 = ColNum(Trim$(parts(1)))
    End If
End Sub

Public Sub CfgSet(ByVal key As String, ByVal value As String)
    Dim ws As Worksheet, f As Range, r As Long
    EnsureConfigSheet
    Set ws = ThisWorkbook.Worksheets(CFG_SHEET)
    Set f = ws.Columns(1).Find(What:=key, LookIn:=xlValues, LookAt:=xlWhole, MatchCase:=False)
    If f Is Nothing Then
        r = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
        ws.Cells(r, 1).value = key
        ws.Cells(r, 2).NumberFormat = "@"
        ws.Cells(r, 2).value = value
    Else
        f.Offset(0, 1).NumberFormat = "@"
        f.Offset(0, 1).value = value
    End If
End Sub

'--- Validate the settings the process cannot run without --------------------
Public Function ValidateConfig(ByRef problems As String) As Boolean
    problems = ""
    If Len(Cfg("REPAYMENT_DATE_COL")) = 0 Then
        problems = problems & "- REPAYMENT_DATE_COL is blank." & vbCrLf
    End If
    If Len(Cfg("TRADE_PAY_DATE_COL")) = 0 Then
        problems = problems & "- TRADE_PAY_DATE_COL is blank." & vbCrLf
    End If
    If Len(Cfg("DATA_SHEET_NAME")) = 0 Then
        problems = problems & "- DATA_SHEET_NAME is blank." & vbCrLf
    End If
    If CfgLong("HEADER_ROW") <= 0 Or CfgLong("FIRST_DATA_ROW") <= CfgLong("HEADER_ROW") Then
        problems = problems & "- HEADER_ROW / FIRST_DATA_ROW are inconsistent." & vbCrLf
    End If
    ValidateConfig = (Len(problems) = 0)
End Function

