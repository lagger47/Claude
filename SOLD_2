'==============================================================================
' STAGE 5  -  SOP Steps 12 to 15
' Sort the SOLD file by Invoice ID, import the SAP extract into AA6 and report
' on the DOC CHECK column.
'==============================================================================
Public Sub Stage5_ImportSapExtract()
    Dim wb As Workbook, ws As Worksheet
    Dim wbSap As Workbook, wsSap As Worksheet
    Dim sapPath As String
    Dim hdrRow As Long, firstRow As Long, lastRow As Long, lastCol As Long
    Dim invCol As Long, pasteCell As String, pasteRow As Long, pasteCol As Long
    Dim sapFirst As Long, sapLast As Long, sapDocCol As Long
    Dim firstSapCol As Long, lastSapCol As Long, colsSpec As String
    Dim nSold As Long, nSap As Long

    Set wb = CurrentSoldBook()
    Set ws = DataSheet(wb)

    hdrRow = CfgLong("HEADER_ROW", 5)
    firstRow = CfgLong("FIRST_DATA_ROW", 6)
    lastCol = ColNum(Cfg("LAST_HEADER_COL", "AT"))
    invCol = ColNum(Cfg("INVOICE_ID_COL", "X"))
    lastRow = LastRowSpan(ws, "A", "W")
    If lastRow < firstRow Then Err.Raise vbObjectError + 40, , "No data rows found on the SOLD FILE."
    nSold = lastRow - firstRow + 1

    '--- Step 12: filter + sort the SOLD data by Invoice ID ------------------
    FastMode True
    On Error Resume Next
    ws.AutoFilterMode = False
    On Error GoTo 0
    ws.Range(ws.Cells(hdrRow, 1), ws.Cells(lastRow, lastCol)).AutoFilter

    With ws.Sort
        .SortFields.Clear
        .SortFields.Add key:=ws.Range(ws.Cells(firstRow, invCol), ws.Cells(lastRow, invCol)), _
                        SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortTextAsNumbers
        .SetRange ws.Range(ws.Cells(hdrRow, 1), ws.Cells(lastRow, lastCol))
        .Header = xlYes
        .Apply
    End With
    FastMode False
    LogWrite "STEP 12", "DONE", "Sorted " & nSold & " rows ascending on column " & _
                          Cfg("INVOICE_ID_COL", "X")

    '--- Step 13: locate and open the SAP export -----------------------------
    sapPath = Cfg("SAP_EXPORT_PATH")
    If Len(sapPath) = 0 Or Len(Dir$(sapPath)) = 0 Then
        sapPath = PickWorkbook("Select the FBL5N export you just saved from SAP")
        If Len(sapPath) = 0 Then Err.Raise vbObjectError + 41, , "No SAP export selected."
        CfgSet "SAP_EXPORT_PATH", sapPath
    End If

    Set wbSap = OpenOrGet(sapPath, True)
    Set wsSap = wbSap.Worksheets(1)

    colsSpec = Cfg("SAP_COPY_COLS", "A:N")
    CfgColSpan "SAP_COPY_COLS", "A:N", firstSapCol, lastSapCol
    sapDocCol = ColNum(Cfg("SAP_DOCNO_COL", "A"))

    GuessSapBlock wsSap, sapDocCol, sapFirst, sapLast

    If CfgBool("CONFIRM_SAP_BLOCK", False) Then
        sapFirst = AskLong("SAP EXPORT - first DATA row (headers excluded)", sapFirst)
        sapLast = AskLong("SAP EXPORT - last DATA row (total row excluded)", sapLast)
    End If
    If sapLast < sapFirst Then Err.Raise vbObjectError + 42, , "The SAP data block is empty."
    nSap = sapLast - sapFirst + 1
    LogWrite "STEP 13", "DONE", "Extract data block taken as rows " & sapFirst & _
                         " to " & sapLast & " (" & nSap & " rows); total line discarded."

    '--- sort the extract on document number so the two blocks line up -------
    With wsSap.Sort
        .SortFields.Clear
        .SortFields.Add key:=wsSap.Range(wsSap.Cells(sapFirst, sapDocCol), wsSap.Cells(sapLast, sapDocCol)), _
                        SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortTextAsNumbers
        .SetRange wsSap.Range(wsSap.Cells(sapFirst, firstSapCol), wsSap.Cells(sapLast, lastSapCol))
        .Header = xlNo
        .Apply
    End With

    If nSap <> nSold Then
        If MsgBox("Row count mismatch." & vbCrLf & vbCrLf & _
                  "SOLD FILE data rows : " & nSold & vbCrLf & _
                  "SAP extract rows    : " & nSap & vbCrLf & vbCrLf & _
                  "The two blocks will not line up row for row and DOC CHECK will show differences." & vbCrLf & _
                  "Paste anyway?", vbExclamation + vbYesNo, "Step 14") <> vbYes Then
            Err.Raise vbObjectError + 43, , "Paste cancelled - row counts did not match (" & nSold & " vs " & nSap & ")."
        End If
        LogWrite "STEP 14", "CHECK", "Row count mismatch: SOLD " & nSold & " vs SAP " & nSap
    End If

    '--- Step 14: paste values into AA6 --------------------------------------
    pasteCell = Cfg("SAP_PASTE_CELL", "AA6")
    pasteRow = ws.Range(pasteCell).Row
    pasteCol = ws.Range(pasteCell).Column

    FastMode True
    ws.Range(ws.Cells(pasteRow, pasteCol), _
             ws.Cells(pasteRow + nSap - 1, pasteCol + (lastSapCol - firstSapCol))).Clear
    wsSap.Range(wsSap.Cells(sapFirst, firstSapCol), wsSap.Cells(sapLast, lastSapCol)).Copy _
        Destination:=ws.Cells(pasteRow, pasteCol)
    Application.CutCopyMode = False
    FastMode False

    wbSap.Close SaveChanges:=False
    LogWrite "STEP 13-14", "DONE", nSap & " SAP rows pasted at " & pasteCell & " (" & colsSpec & ")"

    '--- Step 15: DOC CHECK ---------------------------------------------------
    Dim flagged As Long
    flagged = ReportDocCheck(ws, hdrRow, firstRow, lastRow)

    wb.Save
    ws.Activate
    ws.Range(pasteCell).Select

    If flagged = 0 Then
        MsgBox "Steps 12 to 15 complete." & vbCrLf & vbCrLf & _
               "DOC CHECK is clean - no differences found across " & nSold & " rows.", _
               vbInformation, "Stage 5 complete"
    Else
        MsgBox "Steps 12 to 15 complete." & vbCrLf & vbCrLf & _
               "DOC CHECK has flagged " & flagged & " row(s). They are highlighted in red in column " & _
               Cfg("DOC_CHECK_COL", "AT") & "." & vbCrLf & vbCrLf & _
               "Investigate these before you continue. Press RUN NEXT STEP when you are satisfied.", _
               vbExclamation, "Stage 5 - DOC CHECK differences"
    End If
End Sub

'--- Guess where the real data starts and ends in an SAP export --------------
Private Sub GuessSapBlock(wsSap As Worksheet, ByVal docCol As Long, _
                          ByRef firstRow As Long, ByRef lastRow As Long)
    Dim r As Long, lastUsed As Long, v As String
    lastUsed = wsSap.Cells(wsSap.Rows.Count, docCol).End(xlUp).Row

    firstRow = 0
    For r = 1 To lastUsed
        v = Trim$(CStr(wsSap.Cells(r, docCol).value))
        If Len(v) > 0 And IsNumeric(Replace(v, " ", "")) Then
            firstRow = r
            Exit For
        End If
    Next r
    If firstRow = 0 Then firstRow = 2

    lastRow = lastUsed

    ' the final populated row of an FBL5N extract is the total line
    If CfgBool("DROP_LAST_EXPORT_ROW", True) Then lastRow = lastRow - 1

    ' then trim anything else at the bottom that is not a document number
    Do While lastRow >= firstRow
        v = UCase$(Trim$(CStr(wsSap.Cells(lastRow, docCol).value)))
        If Len(v) > 0 And IsNumeric(Replace(v, " ", "")) And InStr(v, "TOTAL") = 0 And InStr(v, "*") = 0 Then Exit Do
        lastRow = lastRow - 1
    Loop
End Sub

Private Function AskLong(ByVal prompt As String, ByVal suggested As Long) As Long
    Dim s As String
    s = InputBox(prompt, "SOLD FILE Builder", CStr(suggested))
    If Len(s) = 0 Then Err.Raise vbObjectError + 44, , "Cancelled at: " & prompt
    If Not IsNumeric(s) Then Err.Raise vbObjectError + 45, , "Not a row number: " & s
    AskLong = CLng(s)
End Function

'--- Step 15 helper: evaluate the DOC CHECK column ---------------------------
Private Function ReportDocCheck(ws As Worksheet, ByVal hdrRow As Long, _
                                ByVal firstRow As Long, ByVal lastRow As Long) As Long
    Dim dcCol As Long, r As Long, v As String, okList As String, flagged As Long
    Dim rng As Range

    dcCol = ColNum(Cfg("DOC_CHECK_COL", "AT"))
    okList = "|" & UCase$(Cfg("DOC_CHECK_OK_VALUES", "OK|TRUE|MATCH|0|-|YES")) & "|"

    Set rng = ws.Range(ws.Cells(firstRow, dcCol), ws.Cells(lastRow, dcCol))
    rng.Interior.pattern = xlNone
    Application.Calculate

    For r = firstRow To lastRow
        v = UCase$(Trim$(CStr(ws.Cells(r, dcCol).Text)))
        If Len(v) > 0 Then
            If InStr(okList, "|" & v & "|") = 0 Then
                ws.Cells(r, dcCol).Interior.Color = RGB(255, 199, 206)
                ws.Cells(r, dcCol).Font.Color = RGB(156, 0, 6)
                flagged = flagged + 1
            End If
        End If
    Next r

    LogWrite "STEP 15", IIf(flagged = 0, "DONE", "CHECK"), _
                         "DOC CHECK flagged " & flagged & " of " & (lastRow - firstRow + 1) & " rows."
    ReportDocCheck = flagged
End Function

'==============================================================================
' STAGE 6  -  SOP Steps 16 to 18
' Repair the Net Due Date / Document Date columns, force the nominated columns
' to text, then sort oldest to newest on Repayment Date.
'==============================================================================
Public Sub Stage6_CleanUpColumns()
    Dim wb As Workbook, ws As Worksheet
    Dim hdrRow As Long, firstRow As Long, lastRow As Long, lastCol As Long
    Dim fixedA As Long, fixedB As Long, badA As Long, badB As Long
    Dim textCols() As String, i As Long, txtDone As String
    Dim repCol As Long

    Set wb = CurrentSoldBook()
    Set ws = DataSheet(wb)
    hdrRow = CfgLong("HEADER_ROW", 5)
    firstRow = CfgLong("FIRST_DATA_ROW", 6)
    lastCol = ColNum(Cfg("LAST_HEADER_COL", "AT"))
    lastRow = LastRowSpan(ws, "A", Cfg("LAST_HEADER_COL", "AT"))

    FastMode True

    '--- Step 16: date columns ------------------------------------------------
    fixedA = RepairDateColumn(ws, Cfg("NET_DUE_DATE_COL", "AJ"), firstRow, lastRow, badA)
    fixedB = RepairDateColumn(ws, Cfg("DOC_DATE_COL", "AK"), firstRow, lastRow, badB)
    LogWrite "STEP 16", IIf(badA + badB = 0, "DONE", "CHECK"), _
        "Net Due Date fixed " & fixedA & " (unparsed " & badA & "); Document Date fixed " & fixedB & _
        " (unparsed " & badB & ")"

    '--- Step 17: force columns to text --------------------------------------
    Dim spec As String
    spec = Cfg("TEXT_COLS", "AUTO")
    If UCase$(Trim$(spec)) = "AUTO" Then
        spec = DetectTextErrorCols(ws, Cfg("TEXT_SCAN_COLS", "AA:AN"), firstRow, lastRow)
        LogWrite "STEP 17", "DONE", "AUTO scan of " & Cfg("TEXT_SCAN_COLS", "AA:AN") & _
                             " found error flags in: " & IIf(Len(spec) = 0, "(none)", spec)
    End If
    textCols = Split(Replace(Replace(spec, " ", ""), ";", ","), ",")
    For i = LBound(textCols) To UBound(textCols)
        If Len(textCols(i)) > 0 Then
            ForceColumnToText ws, textCols(i), firstRow, lastRow
            txtDone = txtDone & textCols(i) & " "
        End If
    Next i
    LogWrite "STEP 17", IIf(Len(txtDone) = 0, "SKIP", "DONE"), _
        IIf(Len(txtDone) = 0, "TEXT_COLS is blank on CONFIG - nothing converted.", "Forced to text: " & Trim$(txtDone))

    '--- Step 18: sort oldest to newest on Repayment Date --------------------
    repCol = ColNum(Cfg("REPAYMENT_DATE_COL"))
    If repCol = 0 Then Err.Raise vbObjectError + 50, , "REPAYMENT_DATE_COL is not set on the CONFIG sheet."
    NormaliseDateColumn ws, Cfg("REPAYMENT_DATE_COL"), firstRow, lastRow

    With ws.Sort
        .SortFields.Clear
        .SortFields.Add key:=ws.Range(ws.Cells(firstRow, repCol), ws.Cells(lastRow, repCol)), _
                        SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortNormal
        .SetRange ws.Range(ws.Cells(hdrRow, 1), ws.Cells(lastRow, lastCol))
        .Header = xlYes
        .Apply
    End With
    LogWrite "STEP 18", "DONE", "Sorted oldest to newest on column " & Cfg("REPAYMENT_DATE_COL")

    wb.Save
    FastMode False
    ws.Activate

    MsgBox "Steps 16 to 18 complete." & vbCrLf & vbCrLf & _
           "Net Due Date repaired : " & fixedA & IIf(badA > 0, "  (" & badA & " could not be parsed)", "") & vbCrLf & _
           "Document Date repaired: " & fixedB & IIf(badB > 0, "  (" & badB & " could not be parsed)", "") & vbCrLf & _
           "Forced to text        : " & IIf(Len(txtDone) = 0, "none configured", Trim$(txtDone)) & vbCrLf & _
           "Sorted on             : " & Cfg("REPAYMENT_DATE_COL") & " (oldest first)", _
           vbInformation, "Stage 6 complete"
End Sub

'--- Convert a badly formatted column into real dates -----------------------
Private Function RepairDateColumn(ws As Worksheet, ByVal colLetter As String, _
                                  ByVal firstRow As Long, ByVal lastRow As Long, _
                                  ByRef unparsed As Long) As Long
    Dim c As Long, r As Long, arr As Variant, d As Variant, n As Long
    unparsed = 0
    If Len(Trim$(colLetter)) = 0 Then Exit Function
    c = ColNum(colLetter)
    If c = 0 Then Exit Function

    arr = ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).value
    For r = 1 To UBound(arr, 1)
        If Len(Trim$(CStr(arr(r, 1)))) > 0 Then
            d = ParseAnyDate(arr(r, 1), DayFirst())
            If IsEmpty(d) Then
                unparsed = unparsed + 1
                ws.Cells(firstRow + r - 1, c).Interior.Color = RGB(255, 235, 156)
            Else
                arr(r, 1) = CDate(d)
                n = n + 1
            End If
        End If
    Next r

    With ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c))
        .NumberFormat = Cfg("DATE_FORMAT_OUT", "dd-mm-yyyy")
        .value = arr
        .HorizontalAlignment = xlCenter
    End With
    RepairDateColumn = n
End Function

Private Sub NormaliseDateColumn(ws As Worksheet, ByVal colLetter As String, _
                                ByVal firstRow As Long, ByVal lastRow As Long)
    Dim dummy As Long
    RepairDateColumn ws, colLetter, firstRow, lastRow, dummy
End Sub

'--- Force a column to text values ------------------------------------------
Private Sub ForceColumnToText(ws As Worksheet, ByVal colLetter As String, _
                              ByVal firstRow As Long, ByVal lastRow As Long)
    Dim c As Long, r As Long, arr As Variant, s As String
    c = ColNum(colLetter)
    If c = 0 Then Exit Sub

    arr = ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c)).value
    For r = 1 To UBound(arr, 1)
        If IsError(arr(r, 1)) Then
            arr(r, 1) = ""
        ElseIf IsNumeric(arr(r, 1)) And Not IsEmpty(arr(r, 1)) Then
            s = Format$(CDbl(arr(r, 1)), "0.##########")
            arr(r, 1) = s
        Else
            arr(r, 1) = Trim$(CStr(arr(r, 1)))
        End If
    Next r

    With ws.Range(ws.Cells(firstRow, c), ws.Cells(lastRow, c))
        .NumberFormat = "@"
        .value = arr
        .HorizontalAlignment = xlLeft
        On Error Resume Next
        .Errors(xlNumberAsText).Ignore = True
        .Errors(xlTextDate).Ignore = True
        On Error GoTo 0
    End With
End Sub

'--- Find the columns Excel is flagging with a "convert to text" indicator ---
Private Function DetectTextErrorCols(ws As Worksheet, ByVal scanSpec As String, _
                                     ByVal firstRow As Long, ByVal lastRow As Long) As String
    Dim c1 As Long, c2 As Long, c As Long, r As Long, stopRow As Long
    Dim hit As Boolean, out As String, skip As String

    If InStr(scanSpec, ":") = 0 Then DetectTextErrorCols = scanSpec: Exit Function
    c1 = ColNum(Trim$(Split(scanSpec, ":")(0)))
    c2 = ColNum(Trim$(Split(scanSpec, ":")(1)))
    If c1 = 0 Or c2 = 0 Then Exit Function

    ' the two date columns were repaired in Step 16 - leave them alone
    skip = "|" & UCase$(Cfg("NET_DUE_DATE_COL", "AJ")) & "|" & _
                 UCase$(Cfg("DOC_DATE_COL", "AK")) & "|"

    stopRow = firstRow + 499
    If stopRow > lastRow Then stopRow = lastRow

    For c = c1 To c2
        If InStr(skip, "|" & UCase$(ColLtr(c)) & "|") = 0 Then
            hit = False
            For r = firstRow To stopRow
                On Error Resume Next
                If ws.Cells(r, c).Errors(xlNumberAsText).value Then hit = True
                If ws.Cells(r, c).Errors(xlTextDate).value Then hit = True
                On Error GoTo 0
                If hit Then Exit For
            Next r
            If hit Then out = out & ColLtr(c) & ","
        End If
    Next c

    If Len(out) > 0 Then out = Left$(out, Len(out) - 1)
    DetectTextErrorCols = out
End Function

'==============================================================================
' STAGE 7  -  SOP Step 19
' Rebuild Ref Key 1 so that it carries only the 4-digit MMDD of the Repayment
' Date (plus any configured prefix / suffix).
'==============================================================================
Public Sub Stage7_RefKey1()
    Dim wb As Workbook, ws As Worksheet
    Dim refCol As Long, repCol As Long, tpCol As Long
    Dim firstRow As Long, lastRow As Long
    Dim asFormula As Boolean, pre As String, sep As String, suf As String
    Dim r As Long, d1 As Variant, d2 As Variant, n As Long, blanks As Long
    Dim f As String, aTP As String, aRP As String, arr As Variant

    Set wb = CurrentSoldBook()
    Set ws = DataSheet(wb)

    refCol = ColNum(Cfg("REF_KEY1_COL", "AO"))
    repCol = ColNum(Cfg("REPAYMENT_DATE_COL", "M"))
    tpCol = ColNum(Cfg("TRADE_PAY_DATE_COL", "J"))
    If refCol = 0 Then Err.Raise vbObjectError + 60, , "REF_KEY1_COL is not set."
    If repCol = 0 Then Err.Raise vbObjectError + 61, , "REPAYMENT_DATE_COL is not set."
    If tpCol = 0 Then Err.Raise vbObjectError + 62, , "TRADE_PAY_DATE_COL is not set."

    firstRow = CfgLong("FIRST_DATA_ROW", 6)
    lastRow = LastRowSpan(ws, "A", Cfg("LAST_HEADER_COL", "AT"))
    asFormula = CfgBool("REFKEY_AS_FORMULA", False)
    pre = Cfg("REFKEY_PREFIX", "MU ")
    sep = Cfg("REFKEY_SEPARATOR", "-")
    suf = Cfg("REFKEY_SUFFIX", "")

    FastMode True

    ' both source columns must be real dates before TEXT() will work
    Dim badTP As Long, badRP As Long
    RepairDateColumn ws, Cfg("TRADE_PAY_DATE_COL", "J"), firstRow, lastRow, badTP
    RepairDateColumn ws, Cfg("REPAYMENT_DATE_COL", "M"), firstRow, lastRow, badRP

    If asFormula Then
        ' a formula written into a cell already formatted as Text displays as
        ' the formula string, so the format has to be General here
        ws.Range(ws.Cells(firstRow, refCol), ws.Cells(lastRow, refCol)).NumberFormat = "General"
    Else
        ws.Range(ws.Cells(firstRow, refCol), ws.Cells(lastRow, refCol)).NumberFormat = "@"
    End If

    If asFormula Then
        aTP = ColLtr(tpCol) & firstRow
        aRP = ColLtr(repCol) & firstRow
        f = "=IF(OR(" & aTP & "=""""," & aRP & "=""""),""""," & _
            """" & pre & """&TEXT(" & aTP & ",""mmdd"")&""" & sep & """&TEXT(" & aRP & ",""mmdd"")" & _
            IIf(Len(suf) > 0, "&""" & suf & """", "") & ")"
        ws.Range(ws.Cells(firstRow, refCol), ws.Cells(lastRow, refCol)).Formula = f
        Application.Calculate
        n = Application.WorksheetFunction.CountIf( _
                ws.Range(ws.Cells(firstRow, refCol), ws.Cells(lastRow, refCol)), "?*")
        blanks = (lastRow - firstRow + 1) - n
    Else
        ReDim arr(1 To lastRow - firstRow + 1, 1 To 1)
        For r = firstRow To lastRow
            d1 = ParseAnyDate(ws.Cells(r, tpCol).value, DayFirst())
            d2 = ParseAnyDate(ws.Cells(r, repCol).value, DayFirst())
            If IsEmpty(d1) Or IsEmpty(d2) Then
                arr(r - firstRow + 1, 1) = ""
                blanks = blanks + 1
            Else
                arr(r - firstRow + 1, 1) = pre & Format$(CDate(d1), "mmdd") & sep & _
                                           Format$(CDate(d2), "mmdd") & suf
                n = n + 1
            End If
        Next r
        ws.Range(ws.Cells(firstRow, refCol), ws.Cells(lastRow, refCol)).value = arr
    End If

    ws.Range(ws.Cells(firstRow, refCol), ws.Cells(lastRow, refCol)).HorizontalAlignment = xlLeft
    wb.Save
    FastMode False

    LogWrite "STEP 19", IIf(blanks = 0, "DONE", "CHECK"), _
        "Ref Key 1 = " & pre & "MMDD" & sep & "MMDD" & suf & " from " & _
        Cfg("TRADE_PAY_DATE_COL", "J") & " and " & _
        Cfg("REPAYMENT_DATE_COL", "M") & " for " & n & " rows" & _
        IIf(blanks > 0, "; " & blanks & " blank (a source date was missing)", "") & _
        IIf(asFormula, " [live formula]", " [static text]")

    ws.Activate
    ws.Cells(firstRow, refCol).Select
    MsgBox "Step 19 complete." & vbCrLf & vbCrLf & _
           "Column " & Cfg("REF_KEY1_COL", "AO") & " now reads e.g.  " & _
           pre & "0316" & sep & "0324" & suf & vbCrLf & _
           "  first block  = " & Cfg("TRADE_PAY_DATE_COL", "J") & " (Trade Payment Date)" & vbCrLf & _
           "  second block = " & Cfg("REPAYMENT_DATE_COL", "M") & " (Repayment Date)" & vbCrLf & vbCrLf & _
           IIf(blanks > 0, blanks & " row(s) came out blank because a source date was missing." & vbCrLf & vbCrLf, "") & _
           "Check a few rows, then press RUN NEXT STEP to build the LSMW sheet.", _
           vbInformation, "Stage 7 complete"
End Sub

' ----------------------------------------------------------------------------
' ---- modSoldOutput ----
' ----------------------------------------------------------------------------
Public Sub Stage8_BuildLSMW()
    Dim wb As Workbook, wbPrev As Workbook
    Dim ws As Worksheet, wsL As Worksheet, wsPrevL As Worksheet
    Dim lsmwName As String, firstRow As Long, lastRow As Long, nRows As Long
    Dim srcSpec As String, c1 As Long, c2 As Long, nCols As Long
    Dim vals As Variant, refVals As Variant
    Dim refSrcCol As Long, destHdr As String, destCell As Range
    Dim lastHdrText As String, stopCell As Range

    lsmwName = Cfg("LSMW_SHEET_NAME", "LSMW")
    Set wb = CurrentSoldBook()
    Set ws = DataSheet(wb)
    Set wbPrev = PrevSoldBook()

    If Not SoldUtil_SheetExists(wbPrev, lsmwName) Then
        Err.Raise vbObjectError + 70, , "Last week's SOLD FILE has no '" & lsmwName & "' sheet to copy headers from."
    End If
    Set wsPrevL = wbPrev.Worksheets(lsmwName)

    FastMode True

    '--- Step 20: add the sheet ----------------------------------------------
    If SoldUtil_SheetExists(wb, lsmwName) Then
        wb.Worksheets(lsmwName).Cells.Clear
        Set wsL = wb.Worksheets(lsmwName)
    Else
        Set wsL = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        wsL.Name = lsmwName
    End If

    '--- Step 21: copy the header row from last week's LSMW sheet ------------
    wsPrevL.Rows(1).Copy
    wsL.Rows(1).PasteSpecial xlPasteAll
    Application.CutCopyMode = False
    wsL.Rows(1).Font.Bold = True

    '--- Step 22: paste the DATA block (AE:AI by default) --------------------
    firstRow = CfgLong("FIRST_DATA_ROW", 6)
    lastRow = LastRowSpan(ws, "A", Cfg("LAST_HEADER_COL", "AT"))
    nRows = lastRow - firstRow + 1
    If nRows < 1 Then Err.Raise vbObjectError + 71, , "No data rows found on the DATA sheet."

    srcSpec = Cfg("LSMW_SOURCE_COLS", "AE:AI")
    CfgColSpan "LSMW_SOURCE_COLS", "AE:AI", c1, c2
    nCols = c2 - c1 + 1

    lastHdrText = Cfg("LSMW_LAST_HDR", "AR Pledg.")
    Set stopCell = FindHeader(wsL, 1, lastHdrText)
    If Not stopCell Is Nothing Then
        If stopCell.Column <> nCols Then
            LogWrite "STEP 22", "CHECK", _
                "'" & lastHdrText & "' sits in LSMW column " & stopCell.Column & _
                " but " & srcSpec & " is " & nCols & " columns wide. Check LSMW_SOURCE_COLS."
        End If
    End If

    vals = ws.Range(ws.Cells(firstRow, c1), ws.Cells(lastRow, c2)).value
    wsL.Range("A2").Resize(nRows, nCols).value = vals

    '--- Step 23: Ref Key 1 pasted as values ---------------------------------
    refSrcCol = ColNum(Cfg("LSMW_REFKEY_SRC_COL", "AO"))
    destHdr = Cfg("LSMW_REFKEY_DEST_HDR", "Ref Key 1")
    Set destCell = FindHeader(wsL, 1, destHdr)
    If destCell Is Nothing Then
        FastMode False
        Err.Raise vbObjectError + 72, , "Header '" & destHdr & "' was not found on the " & lsmwName & _
                  " sheet. Update LSMW_REFKEY_DEST_HDR on CONFIG."
    End If

    refVals = ws.Range(ws.Cells(firstRow, refSrcCol), ws.Cells(lastRow, refSrcCol)).value
    With wsL.Cells(2, destCell.Column).Resize(nRows, 1)
        .NumberFormat = "@"
        .value = refVals
        .HorizontalAlignment = xlLeft
    End With

    wsL.Columns.AutoFit
    wb.Save
    FastMode False

    LogWrite "STEP 20-23", "DONE", _
        lsmwName & " built: " & nRows & " rows, " & srcSpec & " pasted to A2, Ref Key 1 into column " & _
        ColLtr(destCell.Column)

    wsL.Activate
    wsL.Range("A1").Select
    MsgBox "Steps 20 to 23 complete." & vbCrLf & vbCrLf & _
           "Sheet    : " & lsmwName & vbCrLf & _
           "Rows     : " & nRows & vbCrLf & _
           "Block    : DATA " & srcSpec & " -> A2" & vbCrLf & _
           "Ref Key 1: pasted as values into column " & ColLtr(destCell.Column) & vbCrLf & vbCrLf & _
           "Press RUN NEXT STEP to build the SUMMARY pivot.", vbInformation, "Stage 8 complete"
End Sub

'==============================================================================
' STAGE 9  -  SOP Steps 24 to 27
' Pivot on the DATA range (headers through DOC CHECK, ignoring the top rows),
' Repayment Date on Rows with grouping removed, the five value fields, comma
' formatting, sheet renamed to SUMMARY.
'==============================================================================
Public Sub Stage9_BuildSummary()
    Dim wb As Workbook, ws As Worksheet, wsP As Worksheet
    Dim hdrRow As Long, firstRow As Long, lastRow As Long, lastCol As Long
    Dim srcRange As Range, pc As PivotCache, pt As PivotTable
    Dim rowField As String, valSpec As String, fields() As String
    Dim i As Long, added As Long, missing As String
    Dim sumName As String, numFmt As String
    Dim pf As PivotField

    Set wb = CurrentSoldBook()
    Set ws = DataSheet(wb)

    hdrRow = CfgLong("HEADER_ROW", 5)
    firstRow = CfgLong("FIRST_DATA_ROW", 6)
    lastCol = ColNum(Cfg("DOC_CHECK_COL", "AT"))
    lastRow = LastRowSpan(ws, "A", Cfg("LAST_HEADER_COL", "AT"))
    sumName = Cfg("SUMMARY_SHEET_NAME", "SUMMARY")
    numFmt = Cfg("PIVOT_NUMBER_FORMAT", "#,##0.00")

    If lastRow < firstRow Then Err.Raise vbObjectError + 80, , "No data rows found for the pivot."

    CheckBlankHeaders ws, hdrRow, lastCol

    FastMode True
    On Error Resume Next
    ws.AutoFilterMode = False
    On Error GoTo 0

    '--- Step 24: source range = headers to DOC CHECK, top rows excluded -----
    Set srcRange = ws.Range(ws.Cells(hdrRow, 1), ws.Cells(lastRow, lastCol))

    If SoldUtil_SheetExists(wb, sumName) Then
        Application.DisplayAlerts = False
        wb.Worksheets(sumName).Delete
        Application.DisplayAlerts = True
    End If
    Set wsP = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))

    Set pc = wb.PivotCaches.Create(SourceType:=xlDatabase, SourceData:=srcRange)
    Set pt = pc.CreatePivotTable(TableDestination:=wsP.Range("A3"), TableName:="ptSoldSummary")
    pt.RowAxisLayout xlTabularRow

    '--- Step 25: Repayment Date on Rows -------------------------------------
    rowField = Cfg("PIVOT_ROW_FIELD", "Repayment Date")
    On Error Resume Next
    Set pf = pt.PivotFields(rowField)
    On Error GoTo 0
    If pf Is Nothing Then
        FastMode False
        Err.Raise vbObjectError + 81, , "Pivot field '" & rowField & "' does not exist. " & _
                  "Check the header spelling and PIVOT_ROW_FIELD on CONFIG."
    End If
    pf.Orientation = xlRowField
    pf.Position = 1

    '--- Step 26: remove the automatic date grouping (Years / Quarters / Months)
    UngroupDates pt, rowField

    '--- Step 27: value fields + comma formatting ----------------------------
    valSpec = Cfg("PIVOT_VALUE_FIELDS", "")
    fields = Split(valSpec, "|")
    For i = LBound(fields) To UBound(fields)
        If Len(Trim$(fields(i))) > 0 Then
            If AddValueField(pt, Trim$(fields(i)), numFmt) Then
                added = added + 1
            Else
                missing = missing & Trim$(fields(i)) & vbCrLf
            End If
        End If
    Next i

    pt.ColumnGrand = False      ' no total across measures - they do not add up
    pt.RowGrand = True          ' Grand Total row under every value column
    pt.GrandTotalName = "Grand Total"
    wsP.Columns.AutoFit
    wsP.Name = sumName
    wb.Save
    FastMode False

    LogWrite "STEP 24-27", IIf(Len(missing) = 0, "DONE", "CHECK"), _
        sumName & " built on " & (lastRow - firstRow + 1) & " rows; " & added & " value field(s) added." & _
        IIf(Len(missing) = 0, "", " Missing: " & Replace(missing, vbCrLf, " / "))

    wsP.Activate
    If Len(missing) > 0 Then
        MsgBox "SUMMARY built, but these value fields were not found in the header row:" & vbCrLf & vbCrLf & _
               missing & vbCrLf & _
               "Correct the spelling in PIVOT_VALUE_FIELDS on CONFIG (it must match the header text exactly), " & _
               "then use 'Repeat last step'.", vbExclamation, "Stage 9 - fields missing"
    Else
        MsgBox "Steps 24 to 27 complete." & vbCrLf & vbCrLf & _
               "The '" & sumName & "' sheet holds the pivot: " & rowField & " on Rows (ungrouped), " & _
               added & " value fields with comma formatting." & vbCrLf & vbCrLf & _
               "The SOLD FILE is finished. Save a final copy and hand it over.", _
               vbInformation, "All stages complete"
    End If
End Sub

'--- Add one value field, tolerating the various caption forms ---------------
Private Function AddValueField(pt As PivotTable, ByVal fieldName As String, ByVal numFmt As String) As Boolean
    Dim pf As PivotField, df As PivotField
    On Error Resume Next
    Set pf = pt.PivotFields(fieldName)
    On Error GoTo 0
    If pf Is Nothing Then Exit Function

    On Error GoTo Fail
    Set df = pt.AddDataField(pf, "Sum of " & fieldName, xlSum)
    df.NumberFormat = numFmt
    AddValueField = True
    Exit Function
Fail:
    AddValueField = False
End Function

'--- Strip Excel's automatic date grouping ----------------------------------
Private Sub UngroupDates(pt As PivotTable, ByVal rowField As String)
    Dim pf As PivotField, nm As Variant

    On Error Resume Next
    pt.PivotFields(rowField).DataRange.Cells(1).Ungroup
    On Error GoTo 0

    ' Excel 2016+ can leave Years / Quarters / Months fields behind
    For Each nm In Array("Years", "Quarters", "Months", "Days")
        Set pf = Nothing
        On Error Resume Next
        Set pf = pt.PivotFields(CStr(nm))
        If Not pf Is Nothing Then pf.Orientation = xlHidden
        On Error GoTo 0
    Next nm
End Sub

'--- A pivot cannot be created over a header row with blanks -----------------
Private Sub CheckBlankHeaders(ws As Worksheet, ByVal hdrRow As Long, ByVal lastCol As Long)
    Dim c As Long, blanks As String
    For c = 1 To lastCol
        If Len(Trim$(CStr(ws.Cells(hdrRow, c).value))) = 0 Then
            blanks = blanks & ColLtr(c) & " "
        End If
    Next c
    If Len(blanks) > 0 Then
        Err.Raise vbObjectError + 82, , "The header row " & hdrRow & " is blank in column(s): " & Trim$(blanks) & _
                  ". Excel will not build a pivot over a blank header. Fill them in and try again."
    End If
End Sub


