Public Sub EnsureConfigSheet()
    Dim ws As Worksheet
    Set ws = SoldUtil_GetOrCreateSheet(ThisWorkbook, CFG_SHEET)

    If UCase$(Trim$(CStr(ws.Range("A1").value))) <> "KEY" Then
        ws.Cells.Clear
        ws.Range("A1").value = "KEY"
        ws.Range("B1").value = "VALUE"
        ws.Range("C1").value = "NOTES"
        ws.Range("A1:C1").Font.Bold = True
        ws.Range("A1:C1").Interior.Color = RGB(31, 56, 100)
        ws.Range("A1:C1").Font.Color = vbWhite
        ' Values are written as TEXT. Without this, Excel turns "1:4" into a
        ' time serial and "AV6:AW11" style settings become unreadable.
        ws.Columns("B").NumberFormat = "@"
        WriteDefaults ws
        ws.Columns("A:C").AutoFit
    End If
End Sub

