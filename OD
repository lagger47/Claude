Private Function GetSheet(nm As String) As Worksheet
    On Error Resume Next
    Set GetSheet = ThisWorkbook.Worksheets(nm)
    On Error GoTo 0
End Function


Private Function BuildPlantOwnerDict(wsMap As Worksheet) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare

    Dim lr As Long: lr = wsMap.Cells(wsMap.Rows.Count, 1).End(xlUp).Row
    Dim lc As Long: lc = wsMap.Cells(1, wsMap.Columns.Count).End(xlToLeft).Column
    If lr < 2 Or lc < 1 Then
        Set BuildPlantOwnerDict = d
        Exit Function
    End If

    Dim arr As Variant
    arr = wsMap.Range(wsMap.Cells(1, 1), wsMap.Cells(lr, lc)).Value

    Dim cPlant As Long, cOwner As Long
    cPlant = ResolveCol(arr, MAPPING_PLANT_HDR, True)
    cOwner = ResolveCol(arr, MAPPING_OWNER_HDR, True)

    Dim r As Long, k As String, v As String
    For r = 2 To UBound(arr, 1)
        k = UCase$(Trim$(CStr(arr(r, cPlant))))
        v = Trim$(CStr(arr(r, cOwner)))
        If Len(k) > 0 And Not d.Exists(k) Then d(k) = v
    Next r

    Set BuildPlantOwnerDict = d
End Function


Private Function ResolveCol(arr As Variant, headerName As String, exactMatch As Boolean) As Long
    Dim c As Long, h As String
    For c = 1 To UBound(arr, 2)
        h = Trim$(CStr(arr(1, c)))
        If exactMatch Then
            If StrComp(h, headerName, vbTextCompare) = 0 Then
                ResolveCol = c: Exit Function
            End If
        Else
            If InStr(1, h, headerName, vbTextCompare) > 0 Then
                ResolveCol = c: Exit Function
            End If
        End If
    Next c
    Err.Raise vbObjectError + 1001, "ResolveCol", _
              "Header not found: '" & headerName & "'. Check the header row spelling."
End Function


Private Function ClassifyCIACOA(region As String, reason As String, txt As String) As String
    If reason = "P52" Then ClassifyCIACOA = "CIA": Exit Function

    If region = "NAM" Then
        If reason = "P50" Or reason = "UAP" Then
            ClassifyCIACOA = "COA": Exit Function
        End If
    End If

    If region = "EMEA" Then
        If ContainsAnyWord(txt, COA_KEYWORDS) Then
            ClassifyCIACOA = "COA": Exit Function
        End If
        If ContainsAnyWord(txt, CIA_KEYWORDS) Then
            ClassifyCIACOA = "CIA": Exit Function
        End If
    End If

    ClassifyCIACOA = ""
End Function


Private Function ContainsAnyWord(text As String, pipeList As String) As Boolean
    If Len(text) = 0 Then Exit Function

    If mRegex Is Nothing Then
        Set mRegex = CreateObject("VBScript.RegExp")
        mRegex.IgnoreCase = True
        mRegex.Global = False
    End If

    Dim parts() As String, i As Long, needle As String
    parts = Split(pipeList, "|")
    For i = LBound(parts) To UBound(parts)
        needle = Trim$(parts(i))
        If Len(needle) > 0 Then
            mRegex.Pattern = "\b" & EscapeRegex(needle) & "\b"
            If mRegex.Test(text) Then
                ContainsAnyWord = True: Exit Function
            End If
        End If
    Next i
End Function


Private Function EscapeRegex(s As String) As String
    Dim special As String, i As Long, c As String, out As String
    special = ".\+*?[]^$(){}|"
    For i = 1 To Len(s)
        c = Mid$(s, i, 1)
        If InStr(special, c) > 0 Then out = out & "\" & c Else out = out & c
    Next i
    EscapeRegex = out
End Function
Private Function SanitizeFilename(s As String) As String
    Dim bad As String, i As Long, out As String, ch As String
    bad = "\/:*?""<>|"
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If InStr(bad, ch) > 0 Then out = out & "_" Else out = out & ch
    Next i
    SanitizeFilename = Trim$(out)
End Function
