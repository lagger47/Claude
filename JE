Option Explicit

Sub GenerateJournalEntries()
    Dim wsInput As Worksheet
    Dim wsGL As Worksheet
    Dim wsOutput As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim outputRow As Long
    Dim baseAmount As Double
    Dim markupAmount As Double
    Dim totalAmount As Double
    Dim markupPercent As Double
    Dim colMap As Object
    
    Dim vBU As String
    Dim vCurrency As String
    Dim vPeriods As String
    Dim vYear As String
    Dim vProject As String
    Dim vDept As String
    Dim vAccount As String
    Dim vOutputName As String
    Dim vCompanyAbbr As String
    Dim vSeqYear As String
    Dim vSeqMonth As String
    Dim vSeqNum As String
    Dim vSequence As String
    
    'Set sheets
    On Error Resume Next
    Set wsInput = ThisWorkbook.Sheets("JE-prepare")
    Set wsGL = ThisWorkbook.Sheets("GL")
    On Error GoTo 0
    
    If wsInput Is Nothing Then
        MsgBox "Sheet 'JE-prepare' not found!", vbCritical
        Exit Sub
    End If
    
    If wsGL Is Nothing Then
        MsgBox "Sheet 'GL' not found!", vbCritical
        Exit Sub
    End If
    
    'Get input values
    vBU = Trim(wsInput.Range("B3").Value)
    vCurrency = Trim(wsInput.Range("B4").Value)
    vPeriods = Trim(wsInput.Range("B5").Value)
    vYear = Trim(wsInput.Range("B6").Value)
    markupPercent = Val(wsInput.Range("B7").Value) / 100
    vProject = Trim(wsInput.Range("B11").Value)
    vDept = Trim(wsInput.Range("B12").Value)
    vAccount = Trim(wsInput.Range("B14").Value)
    vOutputName = Trim(wsInput.Range("B17").Value)
    
    'Get sequencing values
    vCompanyAbbr = Trim(wsInput.Range("K17").Value)  'Company abbreviation
    vSeqYear = Trim(wsInput.Range("L17").Value)      'Year
    vSeqMonth = Trim(wsInput.Range("M17").Value)     'Month
    vSeqNum = Trim(wsInput.Range("N17").Value)       'Sequence
    
    'Generate sequence: HCA20260101
    vSequence = vCompanyAbbr & vSeqYear & vSeqMonth & vSeqNum
    
    If vOutputName = "" Then
        vOutputName = "Journal_Output"
    End If
    
    'Create column mapping
    Set colMap = CreateColumnMapping(wsGL)
    
    'Create or clear output sheet
    On Error Resume Next
    Set wsOutput = ThisWorkbook.Sheets(vOutputName)
    On Error GoTo 0
    
    If wsOutput Is Nothing Then
        Set wsOutput = ThisWorkbook.Sheets.Add(After:=wsInput)
        wsOutput.Name = vOutputName
    Else
        wsOutput.Cells.Clear
    End If
    
    'Write headers
    Call WriteHeaders(wsOutput)
    
    'Process GL data
    lastRow = wsGL.Cells(wsGL.Rows.Count, 1).End(xlUp).Row
    outputRow = 2
    baseAmount = 0
    
    For i = 2 To lastRow
        If CheckFilters(wsGL, i, colMap, vBU, vCurrency, vPeriods, vYear, vProject, vDept, vAccount) Then
            Call CopyGLRow(wsGL, i, colMap, wsOutput, outputRow, vSequence)
            'Keep original sign
            baseAmount = baseAmount + GetCellValue(wsGL, i, colMap, "Amount")
            outputRow = outputRow + 1
        End If
    Next i
    
    If baseAmount = 0 Then
        MsgBox "No records found! Check your filters.", vbExclamation
        Exit Sub
    End If
    
    'Add totals
    markupAmount = baseAmount * markupPercent
    totalAmount = baseAmount + markupAmount
    
    'DR Total
    wsOutput.Cells(outputRow, 1).Value = baseAmount
    wsOutput.Cells(outputRow, 2).Value = "TOTAL"
    wsOutput.Cells(outputRow, 11).Value = "TOTAL DEBIT"
    wsOutput.Cells(outputRow, 1).Interior.Color = RGB(220, 240, 220)
    outputRow = outputRow + 1
    
    'CR Total
    wsOutput.Cells(outputRow, 1).Value = -totalAmount
    wsOutput.Cells(outputRow, 2).Value = "TOTAL"
    wsOutput.Cells(outputRow, 11).Value = "TOTAL CREDIT"
    wsOutput.Cells(outputRow, 1).Interior.Color = RGB(240, 220, 220)
    outputRow = outputRow + 1
    
    'Summary
    wsOutput.Cells(outputRow + 1, 1).Value = "Base Amount:"
    wsOutput.Cells(outputRow + 1, 2).Value = baseAmount
    wsOutput.Cells(outputRow + 2, 1).Value = "Markup:"
    wsOutput.Cells(outputRow + 2, 2).Value = markupAmount
    wsOutput.Cells(outputRow + 3, 1).Value = "TOTAL:"
    wsOutput.Cells(outputRow + 3, 2).Value = totalAmount
    
    'Format
    wsOutput.Columns.AutoFit
    
    MsgBox "Done! Found " & (outputRow - 3) & " transactions." & vbCrLf & _
           "Total: " & Format(baseAmount, "#,##0.00"), vbInformation
End Sub

Function CheckFilters(ws As Worksheet, rowNum As Long, colMap As Object, _
    fBU As String, fCurrency As String, fPeriods As String, fYear As String, _
    fProject As String, fDept As String, fAccount As String) As Boolean
    
    Dim ledgerCol As Long
    Dim currencyCol As Long
    Dim periodCol As Long
    Dim yearCol As Long
    Dim projectCol As Long
    Dim deptCol As Long
    Dim accountCol As Long
    Dim periodArr() As String
    Dim p As Integer
    Dim found As Boolean
    Dim accVal As String
    Dim projVal As String
    Dim pattern As String
    
    ledgerCol = 0
    currencyCol = 0
    periodCol = 0
    yearCol = 0
    projectCol = 0
    deptCol = 0
    accountCol = 0
    
    If colMap.Exists("Ledger") Then ledgerCol = colMap("Ledger")
    If colMap.Exists("Currency") Then currencyCol = colMap("Currency")
    If colMap.Exists("Period") Then periodCol = colMap("Period")
    If colMap.Exists("Year") Then yearCol = colMap("Year")
    If colMap.Exists("Project") Then projectCol = colMap("Project")
    If colMap.Exists("Dept") Then deptCol = colMap("Dept")
    If colMap.Exists("Account") Then accountCol = colMap("Account")
    
    CheckFilters = True
    
    'Check BU
    If fBU <> "" And ledgerCol > 0 Then
        If InStr(1, ws.Cells(rowNum, ledgerCol).Value, fBU, vbTextCompare) = 0 Then
            CheckFilters = False
            Exit Function
        End If
    End If
    
    'Check Currency
    If fCurrency <> "" And currencyCol > 0 Then
        If InStr(1, ws.Cells(rowNum, currencyCol).Value, fCurrency, vbTextCompare) = 0 Then
            CheckFilters = False
            Exit Function
        End If
    End If
    
    'Check Period
    If fPeriods <> "" And periodCol > 0 Then
        found = False
        periodArr = Split(fPeriods, ",")
        For p = LBound(periodArr) To UBound(periodArr)
            If InStr(1, ws.Cells(rowNum, periodCol).Value, Trim(periodArr(p)), vbTextCompare) > 0 Then
                found = True
                Exit For
            End If
        Next p
        If Not found Then
            CheckFilters = False
            Exit Function
        End If
    End If
    
    'Check Year
    If fYear <> "" And yearCol > 0 Then
        If InStr(1, ws.Cells(rowNum, yearCol).Value, fYear, vbTextCompare) = 0 Then
            CheckFilters = False
            Exit Function
        End If
    End If
    
    'Check Project (with series support - H*, N*, etc.)
    If fProject <> "" And projectCol > 0 Then
        projVal = ws.Cells(rowNum, projectCol).Value
        
        'Check if filter has wildcard (e.g., H* or N*)
        If InStr(fProject, "*") > 0 Then
            'Extract prefix before *
            pattern = Replace(fProject, "*", "")
            'Check if project starts with the prefix
            If Left(projVal, Len(pattern)) <> pattern Then
                CheckFilters = False
                Exit Function
            End If
        Else
            'Exact match or contains
            If InStr(1, projVal, fProject, vbTextCompare) = 0 Then
                CheckFilters = False
                Exit Function
            End If
        End If
    End If
    
    'Check Dept (FIXED - now working properly)
    If fDept <> "" And deptCol > 0 Then
        If InStr(1, ws.Cells(rowNum, deptCol).Value, fDept, vbTextCompare) = 0 Then
            CheckFilters = False
            Exit Function
        End If
    End If
    
    'Check Account (with wildcard support - e.g., 8*)
    If fAccount <> "" And accountCol > 0 Then
        accVal = ws.Cells(rowNum, accountCol).Value
        
        If InStr(fAccount, "*") > 0 Then
            'Extract prefix before *
            pattern = Replace(fAccount, "*", "")
            'Check if account starts with the prefix
            If Left(accVal, Len(pattern)) <> pattern Then
                CheckFilters = False
                Exit Function
            End If
        Else
            'Contains match
            If InStr(1, accVal, fAccount, vbTextCompare) = 0 Then
                CheckFilters = False
                Exit Function
            End If
        End If
    End If
End Function

Sub CopyGLRow(wsGL As Worksheet, rowNum As Long, colMap As Object, _
    wsOut As Worksheet, outRow As Long, vSequence As String)
    
    Dim amountCol As Long
    Dim accountCol As Long
    Dim affiliateCol As Long
    Dim projectCol As Long
    Dim activityCol As Long
    Dim deptCol As Long
    Dim poolCol As Long
    Dim destCol As Long
    Dim productCol As Long
    Dim refCol As Long
    Dim descrCol As Long
    Dim lineDescrCol As Long
    
    amountCol = 0
    accountCol = 0
    affiliateCol = 0
    projectCol = 0
    activityCol = 0
    deptCol = 0
    poolCol = 0
    destCol = 0
    productCol = 0
    refCol = 0
    descrCol = 0
    lineDescrCol = 0
    
    If colMap.Exists("Amount") Then amountCol = colMap("Amount")
    If colMap.Exists("Account") Then accountCol = colMap("Account")
    If colMap.Exists("Affiliate") Then affiliateCol = colMap("Affiliate")
    If colMap.Exists("Project") Then projectCol = colMap("Project")
    If colMap.Exists("Activity") Then activityCol = colMap("Activity")
    If colMap.Exists("Dept") Then deptCol = colMap("Dept")
    If colMap.Exists("Pool/Prime") Then poolCol = colMap("Pool/Prime")
    If colMap.Exists("Destination") Then destCol = colMap("Destination")
    If colMap.Exists("Product") Then productCol = colMap("Product")
    If colMap.Exists("Ref") Then refCol = colMap("Ref")
    If colMap.Exists("Descr") Then descrCol = colMap("Descr")
    If colMap.Exists("Line Descr") Then lineDescrCol = colMap("Line Descr")
    
    'Keep original sign - NO Abs()
    If amountCol > 0 Then wsOut.Cells(outRow, 1).Value = wsGL.Cells(rowNum, amountCol).Value
    If accountCol > 0 Then wsOut.Cells(outRow, 2).Value = Trim(wsGL.Cells(rowNum, accountCol).Value)
    If affiliateCol > 0 Then wsOut.Cells(outRow, 3).Value = Trim(wsGL.Cells(rowNum, affiliateCol).Value)
    If projectCol > 0 Then wsOut.Cells(outRow, 4).Value = Trim(wsGL.Cells(rowNum, projectCol).Value)
    If activityCol > 0 Then wsOut.Cells(outRow, 5).Value = Trim(wsGL.Cells(rowNum, activityCol).Value)
    If deptCol > 0 Then wsOut.Cells(outRow, 6).Value = Trim(wsGL.Cells(rowNum, deptCol).Value)
    If poolCol > 0 Then wsOut.Cells(outRow, 7).Value = Trim(wsGL.Cells(rowNum, poolCol).Value)
    If destCol > 0 Then wsOut.Cells(outRow, 8).Value = Trim(wsGL.Cells(rowNum, destCol).Value)
    If productCol > 0 Then wsOut.Cells(outRow, 9).Value = Trim(wsGL.Cells(rowNum, productCol).Value)
    If refCol > 0 Then wsOut.Cells(outRow, 10).Value = vSequence  'Use generated sequence
    If lineDescrCol > 0 Then
        'Use Line Descr column (Column U) for description
        wsOut.Cells(outRow, 11).Value = Trim(wsGL.Cells(rowNum, lineDescrCol).Value)
    ElseIf descrCol > 0 Then
        'Fallback to Descr if Line Descr not found
        wsOut.Cells(outRow, 11).Value = Trim(wsGL.Cells(rowNum, descrCol).Value)
    End If
    
    wsOut.Cells(outRow, 1).NumberFormat = "#,##0.00"
    wsOut.Range(wsOut.Cells(outRow, 1), wsOut.Cells(outRow, 11)).Borders.LineStyle = xlContinuous
End Sub

Function GetCellValue(ws As Worksheet, rowNum As Long, colMap As Object, fieldName As String) As Double
    Dim colNum As Long
    colNum = 0
    
    On Error Resume Next
    If colMap.Exists(fieldName) Then
        colNum = colMap(fieldName)
    End If
    On Error GoTo 0
    
    If colNum > 0 Then
        GetCellValue = CDbl(ws.Cells(rowNum, colNum).Value)
    Else
        GetCellValue = 0
    End If
End Function

Sub WriteHeaders(ws As Worksheet)
    ws.Cells(1, 1).Value = "Amount (AUD)"
    ws.Cells(1, 2).Value = "GL ACC"
    ws.Cells(1, 3).Value = "Affiliate"
    ws.Cells(1, 4).Value = "Project"
    ws.Cells(1, 5).Value = "Activity"
    ws.Cells(1, 6).Value = "Dept"
    ws.Cells(1, 7).Value = "Pool"
    ws.Cells(1, 8).Value = "Destination"
    ws.Cells(1, 9).Value = "Product"
    ws.Cells(1, 10).Value = "Reference"
    ws.Cells(1, 11).Value = "Description"
    
    ws.Range(ws.Cells(1, 1), ws.Cells(1, 11)).Font.Bold = True
    ws.Range(ws.Cells(1, 1), ws.Cells(1, 11)).Interior.Color = RGB(200, 218, 240)
End Sub

Function CreateColumnMapping(ws As Worksheet) As Object
    Dim colMap As Object
    Dim lastCol As Long
    Dim i As Long
    Dim hdr As String
    
    Set colMap = CreateObject("Scripting.Dictionary")
    lastCol = ws.Cells(1, Columns.Count).End(xlToLeft).Column
    
    For i = 1 To lastCol
        hdr = Trim(ws.Cells(1, i).Value)
        If hdr <> "" Then
            If Not colMap.Exists(hdr) Then
                colMap.Add hdr, i
            End If
        End If
    Next i
    
    Set CreateColumnMapping = colMap
End Function

